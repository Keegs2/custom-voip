# =============================================================================
# RCF-V1 Production — Services VM Environment
# =============================================================================
# Copy to .env on VM3 and fill in all REQUIRED values.
# PostgreSQL + PgBouncer run bare on this VM (not in Docker).
#
# Usage: docker compose -f docker-compose.services.yml up -d

# JWT authentication — generate with: openssl rand -hex 32
JWT_SECRET_KEY=           # 64+ char random string (REQUIRED)

# Main voip database — bare-metal PostgreSQL via PgBouncer on this VM
DATABASE_URL=postgresql://api:PASSWORD@127.0.0.1:6432/voip

# Redis on VM2 — used for session cache, velocity tracking
REDIS_URL=redis://VM2_INTERNAL_IP:6379

# FreeSWITCH ESL on VM2 — for live call control
FREESWITCH_ESL_HOST=      # VM2 internal IP (REQUIRED)
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=  # Must match ESL_PASSWORD on VM2 (REQUIRED)

# CORS — allowed origins for the UI
CORS_ORIGINS=             # https://VM3_PUBLIC_IP:8443,http://VM3_PUBLIC_IP:8080

# Primary SBC internal IP — for SIP REFER, call routing
SBC_PROXY_IP=             # Primary SBC internal IP

# Bandwidth.com carrier API credentials
BANDWIDTH_API_CLIENT_ID=
BANDWIDTH_API_CLIENT_SECRET=
BANDWIDTH_ACCOUNT_ID=9900717
BANDWIDTH_SIP_PEER_ID=1162116

# Feature flags
TEST_MODE=false
ENABLE_DOCS=true

# PROD-4: deployment environment. MUST be "production" on this VM — it makes the
# API fail-fast at startup if TURN_SECRET / STORAGE_SECRET_KEY / INGEST_SHARED_SECRET
# are still dev defaults / unset.
ENV=production            # REQUIRED — keep as production

# =============================================================================
# SEC-2 ingest auth (REQUIRED) — must match the Media VM's INGEST_SHARED_SECRET
# =============================================================================
# FreeSWITCH sends this as X-Ingest-Secret on CDR/recording/voicemail ingest;
# the API compares it constant-time. Generate: openssl rand -hex 32
INGEST_SHARED_SECRET=     # REQUIRED — IDENTICAL to Media VM value

# =============================================================================
# Object storage — GCS via the S3-interop endpoint (NO MinIO in production)
# =============================================================================
# boto3 is endpoint-agnostic. ACCESS/SECRET keys are GCS HMAC keys (create in
# Cloud Console → Storage → Settings → Interoperability). GCS needs path-style.
STORAGE_ENDPOINT_URL=https://storage.googleapis.com
STORAGE_ACCESS_KEY=       # REQUIRED — GCS HMAC access key (GOOG...)
STORAGE_SECRET_KEY=       # REQUIRED — GCS HMAC secret
STORAGE_REGION=us-east1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_BUCKET_RECORDINGS=voip-recordings
STORAGE_BUCKET_VOICEMAIL=voip-voicemail
STORAGE_BUCKET_UPLOADS=voip-uploads

# =============================================================================
# TURN/STUN — coturn lives on the Media VM; webrtc.py mints time-limited creds
# =============================================================================
TURN_HOST=                # REQUIRED — Media VM PUBLIC IP (what clients reach)
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_SECRET=              # REQUIRED — IDENTICAL to Media VM coturn TURN_SECRET
TURN_REALM=voip.local     # MUST match the Media VM TURN_REALM

# Media ingest caps — OPTIONAL (safe defaults shown).
MEDIA_MAX_BYTES=104857600
MEDIA_MAX_FRAMES=2000000
MEDIA_MAX_DURATION_MS=14400000
MEDIA_MAX_CONCURRENT_STREAMS=200

# UI → Verto WSS endpoint on the Media VM (FreeSWITCH mod_verto). REQUIRED for
# the WebRTC softphone/conference. e.g. wss://<media-vm-public-ip>:8082
VERTO_WS_URL=             # REQUIRED for WebRTC — wss://MEDIA_VM_IP:8082

# Grafana (Homer 10 SIP UI) admin password. REQUIRED — compose refuses to
# start Grafana without it (was defaulting to the well-known "sipcapture").
# Anonymous access is OFF by default; set GRAFANA_ANONYMOUS_ENABLED=true only
# if you consciously want unauthenticated viewers on the office network.
GRAFANA_ADMIN_PASSWORD=   # REQUIRED — openssl rand -hex 16
#GRAFANA_ANONYMOUS_ENABLED=false

# HEP ingest bind address (heplify-server 9060/9061). Set to this VM's VPC IP
# so the host never listens for HEP on the external interface — the SBC/media
# VMs send HEP over the VPC. Default 0.0.0.0 only exists for single-box dev.
HEP_BIND_IP=10.142.0.103

# Grafana/qryn host ports publish on 127.0.0.1 by default (UI proxies
# /grafana/ internally; use an IAP SSH tunnel for direct access). Only
# override on a trusted single-box dev machine.
#GRAFANA_BIND_IP=127.0.0.1
#QRYN_BIND_IP=127.0.0.1

# Homer DB password — legacy Homer 7 (homer-db). Unused by Homer 10 stack.
HOMER_DB_PASS=            # Strong password for Homer DB
