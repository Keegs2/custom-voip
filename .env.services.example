# =============================================================================
# RCF-V1 Production — Services VM Environment
# =============================================================================
# Copy to .env on VM3 and fill in all REQUIRED values.
# PostgreSQL + PgBouncer run bare on this VM (not in Docker).
#
# Usage: docker compose -f docker-compose.services.yml up -d

# JWT authentication — generate with: openssl rand -hex 32
JWT_SECRET_KEY=           # 64+ char random string (REQUIRED)

# Main voip database — bare-metal PostgreSQL via PgBouncer on this VM
DATABASE_URL=postgresql://api:PASSWORD@127.0.0.1:6432/voip

# Redis on VM2 — used for session cache, velocity tracking
REDIS_URL=redis://VM2_INTERNAL_IP:6379

# FreeSWITCH ESL on VM2 — for live call control
FREESWITCH_ESL_HOST=      # VM2 internal IP (REQUIRED)
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=  # Must match ESL_PASSWORD on VM2 (REQUIRED)

# CORS — allowed origins for the UI
CORS_ORIGINS=             # https://VM3_PUBLIC_IP:8443,http://VM3_PUBLIC_IP:8080

# Primary SBC internal IP — for SIP REFER, call routing
SBC_PROXY_IP=             # Primary SBC internal IP

# Bandwidth.com carrier API credentials
BANDWIDTH_API_CLIENT_ID=
BANDWIDTH_API_CLIENT_SECRET=
BANDWIDTH_ACCOUNT_ID=9900717
BANDWIDTH_SIP_PEER_ID=1162116

# Feature flags
TEST_MODE=false
ENABLE_DOCS=true

# Homer DB password — used by homer-db, heplify-server, homer-webapp containers
HOMER_DB_PASS=            # Strong password for Homer DB

# =============================================================================
# Production NOC Grafana dashboards (docker/homer/grafana/dashboards/noc/)
# =============================================================================
# Read-only Postgres role password for the voip-cdr-pg Grafana datasource.
# MUST match the grafana_ro role password you set on the primary via
#   sudo -u postgres psql -d voip -c "ALTER ROLE grafana_ro PASSWORD '...';"
# after applying docker/postgres/init/22_grafana_ro.sql.
GRAFANA_DB_PASSWORD=       # read-only grafana_ro DB password

# GCP Monitoring service-account EMAIL (NOT a secret) for the gcp-monitoring
# datasource JWT auth. The SA's downloaded JSON KEY goes at
#   /opt/revup/secrets/gcp-monitoring-sa.json  (see secrets/README.md)
# and needs roles/monitoring.viewer on project rugged-night-193017.
GCM_SA_EMAIL=             # e.g. grafana-noc-monitoring@rugged-night-193017.iam.gserviceaccount.com

# Carrier-trunk connectivity monitor — shared bearer token.
# The per-SBC carrier-monitor pollers POST their Kamailio dispatcher OPTIONS
# state to POST /v1/carrier-status/report with `Authorization: Bearer <token>`.
# The API validates that token against this value (constant-time). It MUST match
# the CARRIER_STATUS_TOKEN set in every SBC's /opt/revup/.env. If this is unset,
# the API rejects all reports (fail-closed) and the NOC carrier markers go
# stale/red. Generate with: openssl rand -hex 32
CARRIER_STATUS_TOKEN=      # shared secret, must match the SBC pollers' value

# =============================================================================
# Production metrics plane — VictoriaMetrics + vmagent + exporters (East store).
# Backs docker-compose.services.yml (victoriametrics/vmalert/node-exporter/
# postgres-exporter/pgbouncer-exporter/vmagent) + docs/OBSERVABILITY_METRICS_PLAN.md.
# =============================================================================
# This zone's name — stamped as the `zone` external_label on every series this
# VM's vmagent scrapes. One of: east | west | central. (East services VM = east.)
METRICS_ZONE=east
# Stable identity for THIS services VM — stamped as `reporting_instance`. Keep it
# unique/human-readable (matches the CLAUDE.md node naming).
SERVICES_NODE_ID=services
# Read-only Postgres role password for the postgres_exporter (metrics_ro). MUST
# match the metrics_ro role password you set on the East PRIMARY via
#   sudo -u postgres psql -d voip -c "ALTER ROLE metrics_ro PASSWORD '...';"
# after applying docker/postgres/init/26_live_trunk_stats.sql (which also creates
# metrics_ro with pg_monitor). DIRECT :5432, not PgBouncer. openssl rand -hex 32
METRICS_DB_PASSWORD=       # metrics_ro DB password (postgres_exporter)
# PgBouncer stats user password for the pgbouncer_exporter (pgb_stats). MUST match
# the pgb_stats entry in userlist.txt + `stats_users = pgb_stats` in pgbouncer.ini
# on this VM (then `systemctl reload pgbouncer`). openssl rand -hex 32
PGBOUNCER_STATS_PASSWORD=  # pgb_stats PgBouncer stats password (pgbouncer_exporter)
# Shared bearer token the SBC carrier-monitor feeder presents to POST
# /v1/live-trunk-stats/report (the customer-SIP-trunk escape hatch — kept OUT of
# Prometheus). DISTINCT from CARRIER_STATUS_TOKEN. Fail-closed: unset => the API
# rejects all live-trunk-stats reports. Must match LIVE_TRUNK_STATS_TOKEN in the
# SBCs' .env. Generate with: openssl rand -hex 32
LIVE_TRUNK_STATS_TOKEN=    # shared secret for POST /v1/live-trunk-stats/report

# =============================================================================
# revup-ops-agent — READ-ONLY NOC command API (services role) for THIS VM.
# Serves the ted-next console's host reads for the services VM: host.docker_ps /
# docker_logs (api, ui, grafana, qryn, clickhouse, heplify, …), host.git_head,
# host.journalctl (docker/pgbouncer/postgresql units). NO kamcmd/ESL here — the
# services role exposes only host.* commands. Fail-closed bearer auth.
# NOTE: this is the ops-agent's OWN token, distinct from the API's
# CARRIER_STATUS_TOKEN above; it is validated by the ops-agent, not the API.
# =============================================================================
# Bearer token the console presents on `Authorization: Bearer <token>` to POST
# /run. FAIL-CLOSED: if UNSET, every /run returns 401 (/healthz still answers).
# Use the SAME token the console is configured with. Generate: openssl rand -hex 32
OPS_AGENT_TOKEN=          # REQUIRED to enable the command API (else all /run 401)

# TCP port the command API listens on (published on the VM). Default 8710.
# SECURITY: VPC-internal ONLY — add a firewall rule allowing tcp:8710 from just
# the console host(s). Not for internet exposure.
OPS_AGENT_PORT=8710

# Role this agent exposes. Forced to `services` on this VM (host.* commands only).
OPS_AGENT_ROLE=services

# =============================================================================
# CDR Export Forwarder (Equinox → FileMage FTP) — OPT-IN, OFF BY DEFAULT
# =============================================================================
# Backs docker/api/src/services/cdr_export/. Runs as the opt-in `cdr-exporter`
# compose service (profile: cdr-export) OR via the CLI inside the api container.
# See docker/api/src/services/cdr_export/README.md for the full reference.
#
# Master switch. Leave false until the FTP creds + Equinox format are confirmed.
# When false, run-once/run-loop no-op; test-connection/dry-run still work.
CDR_EXPORT_ENABLED=false

# FileMage FTP gateway (internal, behind firewall — plain FTP on 21 by default)
CDR_EXPORT_FTP_HOST=10.142.0.71
CDR_EXPORT_FTP_PORT=21
CDR_EXPORT_FTP_USER=            # FileMage FTP username (REQUIRED to send)
CDR_EXPORT_FTP_PASSWORD=        # FileMage FTP password (REQUIRED to send; never logged)
CDR_EXPORT_FTP_DIR=/            # Remote drop directory
CDR_EXPORT_FTP_PASSIVE=true
CDR_EXPORT_FTP_TLS=false        # true = explicit FTPS instead of plain FTP
CDR_EXPORT_FTP_TIMEOUT=30

# Batch / watermark behavior
CDR_EXPORT_BATCH_SIZE=5000
CDR_EXPORT_LAG_SECONDS=120      # only export rows whose end_time < now() - lag
CDR_EXPORT_SKIP_EMPTY=true
CDR_EXPORT_INTERVAL_SECONDS=3600  # run-loop cadence
#CDR_EXPORT_LOCK_TTL_SECONDS=900  # single-instance lease TTL (crashed runner auto-recovers after this)

# Filename convention  ->  {prefix}{timestamp}_{8hex}{ext}
CDR_EXPORT_FILENAME_PREFIX=CDR_
CDR_EXPORT_FILENAME_EXT=.csv
CDR_EXPORT_FILENAME_TS_FORMAT=%Y%m%d%H%M%S
