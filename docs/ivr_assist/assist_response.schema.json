{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crag:ivr-assist:response:v1",
  "title": "Visual IVR Flow assistant: TED to CRAG response v1 (IVR_ASSIST_INTERFACES.md section 3)",
  "description": "The 200 body. A proposal's `graph` is an alias graph (alias_graph.schema.json), validated separately.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "request_id", "result", "meta"],
  "properties": {
    "v": { "const": 1 },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "graph", "new_prompts", "summary", "assumptions"],
          "properties": {
            "kind": { "const": "proposal" },
            "graph": { "type": "object" },
            "new_prompts": {
              "type": "array",
              "maxItems": 20,
              "items": { "$ref": "#/$defs/newPrompt" }
            },
            "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
            "assumptions": {
              "type": "array",
              "maxItems": 10,
              "items": { "type": "string", "minLength": 1, "maxLength": 300 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "question"],
          "properties": {
            "kind": { "const": "clarify" },
            "question": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "message"],
          "properties": {
            "kind": { "const": "cannot_build" },
            "message": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "prompt_version", "attempts", "input_tokens", "output_tokens"],
      "properties": {
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "prompt_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 2 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  },
  "$defs": {
    "newPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "text"],
      "properties": {
        "key": { "type": "string", "pattern": "^NP[1-9][0-9]?$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
