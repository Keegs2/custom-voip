{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crag:ivr-assist:request:v1",
  "title": "Visual IVR Flow assistant: CRAG to TED request v1 (IVR_ASSIST_INTERFACES.md section 2)",
  "description": "The decoded payload_b64. `base` is an alias graph (alias_graph.schema.json) or null, validated separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "request_id",
    "conversation_id",
    "round",
    "message",
    "history",
    "base",
    "base_new_prompts",
    "destinations",
    "prompts",
    "external_numbers",
    "repair",
    "limits"
  ],
  "properties": {
    "v": { "const": 1 },
    "request_id": { "$ref": "#/$defs/uuid" },
    "conversation_id": { "$ref": "#/$defs/uuid" },
    "round": { "enum": ["propose", "repair"] },
    "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "history": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "text"],
        "properties": {
          "role": { "enum": ["customer", "assistant"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "base": { "type": ["object", "null"] },
    "base_new_prompts": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/newPrompt" }
    },
    "destinations": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "product", "label", "enabled", "this_flow"],
        "properties": {
          "alias": { "type": "string", "pattern": "^D[1-9][0-9]{0,2}$" },
          "product": { "enum": ["rcf", "voicemail", "ivr", "trunk"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "enabled": { "type": "boolean" },
          "this_flow": { "type": "boolean" }
        }
      }
    },
    "prompts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "name", "text"],
        "properties": {
          "alias": { "type": "string", "pattern": "^P[1-9][0-9]{0,2}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "text": { "type": ["string", "null"], "maxLength": 1000 }
        }
      }
    },
    "external_numbers": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^N[1-9][0-9]?$" }
    },
    "repair": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["issues"],
          "properties": {
            "issues": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "message"],
                "properties": {
                  "code": { "type": "string", "minLength": 1, "maxLength": 64 },
                  "message": { "type": "string", "minLength": 1, "maxLength": 300 },
                  "node_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" }
                }
              }
            }
          }
        }
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_nodes", "max_new_prompts", "max_prompt_chars"],
      "properties": {
        "max_nodes": { "type": "integer", "minimum": 1, "maximum": 60 },
        "max_new_prompts": { "type": "integer", "minimum": 0, "maximum": 20 },
        "max_prompt_chars": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "newPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "text"],
      "properties": {
        "key": { "type": "string", "pattern": "^NP[1-9][0-9]?$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
