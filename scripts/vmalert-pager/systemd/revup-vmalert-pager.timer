# Every-60s tick for the vmalert pager. Monotonic (not OnCalendar) so ticks are
# evenly spaced regardless of boot time — same shape as revup-fs-watchdog.timer.
# (Persistent= only applies to OnCalendar timers; a missed poll has nothing to
# catch up on, the next tick re-reads the live alert list.) 120s boot delay
# lets docker + the services compose stack (victoriametrics → vmalert) come up
# before the first poll, so a reboot does not start the API-failure counter.
# Placement: /etc/systemd/system/ (installed by install_vmalert_pager.sh)
[Unit]
Description=revup vmalert alert pager (every 60s)

[Timer]
OnBootSec=120s
OnUnitActiveSec=60s
AccuracySec=10s

[Install]
WantedBy=timers.target
