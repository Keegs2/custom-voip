# =============================================================================
# revup database backup configuration — /etc/revup/backup.env
# =============================================================================
# Installed by scripts/backup/install_backup_timers.sh (copied only if absent).
# Read by the systemd backup units via EnvironmentFile=. NO SECRETS BELONG HERE
# — GCS auth comes from the VM's attached service account (metadata token).
#
# Placement on the services VM:  /etc/revup/backup.env  (mode 0644, root:root)

# GCS bucket that holds ALL database backup artifacts (created by infra/backups).
# Layout inside the bucket:
#   pgdump/       nightly logical dumps      (lifecycle-deleted after 35 days)
#   cdr-archive/  monthly CDR month exports  (kept long-term for billing)
#   pgbackrest/   pgBackRest repo            (pgBackRest manages its own expiry)
BACKUP_BUCKET=revup-db-backups

# Database to back up (the production voip DB on this VM's bare-metal PG16).
BACKUP_DB=voip

# Local scratch directory for dumps before upload (pruned automatically).
BACKUP_WORK_DIR=/var/backups/revup

# Days of nightly dumps to also keep on the LOCAL disk (fast restores without
# GCS). GCS retention is longer and governed by the bucket lifecycle policy.
BACKUP_LOCAL_KEEP_DAYS=2

# Replication-slot WAL watchdog: page (via revup-alert syslog line) when a slot
# retains more than this many bytes of WAL on the primary. 8 GiB default.
SLOT_WAL_ALERT_BYTES=8589934592
