# Monthly CDR month-export to GCS BEFORE the TimescaleDB 90-day purge deletes
# billing evidence. Placement: /etc/systemd/system/ (install_backup_timers.sh)
[Unit]
Description=revup monthly CDR archive to GCS
OnFailure=revup-alert@%p.service

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=-/etc/revup/backup.env
ExecStart=/opt/revup/scripts/backup/cdr_archive_monthly.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=4h
