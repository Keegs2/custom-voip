# Inbound call-quality (ASR) watchdog (see asr_guard.sh header).
# Emits its own specific revup-alert line when ASR collapses; OnFailure adds
# the generic one if the guard itself errors.
# Placement: /etc/systemd/system/ (installed by install_backup_timers.sh)
[Unit]
Description=revup inbound ASR watchdog
OnFailure=revup-alert@%p.service

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=-/etc/revup/backup.env
ExecStart=/opt/revup/scripts/backup/asr_guard.sh
