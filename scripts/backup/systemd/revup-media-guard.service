# One-way / no-inbound-RTP watchdog (see media_guard.sh header;
# docs/CALL_QUALITY_ACCURACY_PLAN.md §F). Emits its own specific revup-alert
# line when one-way-audio calls spike; OnFailure adds the generic one if the
# guard itself errors.
# Placement: /etc/systemd/system/ (installed by install_backup_timers.sh)
[Unit]
Description=revup one-way audio (no inbound RTP) watchdog
OnFailure=revup-alert@%p.service

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=-/etc/revup/backup.env
ExecStart=/opt/revup/scripts/backup/media_guard.sh
