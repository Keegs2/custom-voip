# Every-60s tick for the FreeSWITCH media watchdog. Monotonic (not OnCalendar)
# so ticks are evenly spaced regardless of boot time; 90s boot delay lets
# docker + the media stack come up before the first check.
# Placement: /etc/systemd/system/ (installed by install_fs_watchdog.sh)
[Unit]
Description=revup FreeSWITCH media watchdog (every 60s)

[Timer]
OnBootSec=90s
OnUnitActiveSec=60s
AccuracySec=10s

[Install]
WantedBy=timers.target
