# Voice Platform Environment Configuration
# Copy this to .env and customize for your environment

# PostgreSQL
POSTGRES_DB=voip
POSTGRES_USER=voip
POSTGRES_PASSWORD=voip_secret

# Redis
REDIS_URL=redis://redis:6379

# FreeSWITCH — Event Socket password. NEVER use the well-known "ClueCon"
# (FreeSWITCH entrypoint.sh hard-fails on it). Set a strong value in your .env;
# it must match between the API and the FreeSWITCH container.
FREESWITCH_ESL_PASSWORD=change-me-strong-esl-password

# API
API_SECRET_KEY=your-secret-key-here
DEBUG=false

# Shared DID inventory (Phases 2-3)
# INVENTORY_READ_URL: optional read-only prod replica for DID inventory reads.
#   Empty -> falls back to the primary DATABASE_URL (no-op, today's behavior).
INVENTORY_READ_URL=
# DEPLOY_ENV: environment this API serves (prod | sandbox). Drives the routing
#   reconciliation guard. Default prod.
DEPLOY_ENV=prod
# INVENTORY_GUARD_ENFORCE: true (default) enforces the guard; false disables it.
INVENTORY_GUARD_ENFORCE=true

# Test Mode (disable carrier connections for testing)
TEST_MODE=true

# Carrier Settings (for production)
# CARRIER_PREMIUM_HOST=sip.carrier1.com
# CARRIER_PREMIUM_USER=username
# CARRIER_PREMIUM_PASS=password
# CARRIER_STANDARD_HOST=sip.carrier2.com
# CARRIER_STANDARD_USER=username
# CARRIER_STANDARD_PASS=password
