# ============================================================================
# .env.test — ALL-IN-ONE test VM (full unified stack on ONE box, REAL carrier)
# Copy to /opt/revup/.env on the test VM and fill the REQUIRED values.
# Used with the local all-in-one compose:  sudo docker compose up -d
#
# This runs Kamailio (SBC) + FreeSWITCH + Postgres + Redis + API + UI + MinIO +
# coturn + Homer on a single VM. On a real Linux host (unlike Docker Desktop)
# the FS<->API host-net/bridge paths work, so this is a true end-to-end test.
# ============================================================================

# --- PUBLIC ADDRESSING (REQUIRED) -------------------------------------------
# The test VM's OWN public (external) IP. Used in SIP Via/Contact + SDP.
# Because SBC+FS are co-located, the carrier-facing advertise IP == FS public IP.
EXTERNAL_SIP_IP=REPLACE_WITH_TEST_VM_PUBLIC_IP
EXTERNAL_RTP_IP=REPLACE_WITH_TEST_VM_PUBLIC_IP
FS_PUBLIC_IP=REPLACE_WITH_TEST_VM_PUBLIC_IP

# --- SINGLE-BOX SIP TOPOLOGY (loopback co-location) -------------------------
# Kamailio advertises the public IP but routes to FS on localhost; FS routes
# back to Kamailio on localhost. SBC_INTERNAL == 127.0.0.1 (same host).
FREESWITCH_IP=127.0.0.1
SBC_INTERNAL_IP=127.0.0.1
SBC_PROXY_IP=127.0.0.1
SBC_PROXY_IP_FAILOVER=127.0.0.1

# FS->API: the API is PUBLISHED on the host at 8088 (host:8088 -> container:8000),
# and FreeSWITCH (host networking) reaches it at 127.0.0.1:8088. Set API_PORT=8088
# so the FS env and the host publish agree (default would mismatch 8000 vs 8088).
API_HOST=127.0.0.1
API_PORT=8088

# --- REAL CARRIER (REQUIRED for live calls) ---------------------------------
# TEST_MODE=false bridges real calls to Bandwidth. Set true to just play a tone.
TEST_MODE=false
BANDWIDTH_API_CLIENT_ID=REPLACE
BANDWIDTH_API_CLIENT_SECRET=REPLACE
BANDWIDTH_ACCOUNT_ID=9900717
BANDWIDTH_SIP_PEER_ID=REPLACE_WITH_TEST_PEER_ID
# Carrier PoP IPs default to East Dallas/LA (see docker/kamailio/CLAUDE.md).

# --- SECRETS (REQUIRED — generate fresh, do NOT reuse prod) ------------------
JWT_SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
FREESWITCH_ESL_PASSWORD=REPLACE_strong_value_not_ClueCon
ESL_PASSWORD=REPLACE_strong_value_not_ClueCon   # must equal FREESWITCH_ESL_PASSWORD
INGEST_SHARED_SECRET=REPLACE_with_openssl_rand_hex_24
TURN_SECRET=REPLACE_with_openssl_rand_hex_24

# --- WEBRTC / TURN (its own public addressing) ------------------------------
TURN_HOST=REPLACE_WITH_TEST_VM_PUBLIC_IP
TURN_REALM=test.voiceplatform.local
VERTO_WS_URL=wss://REPLACE_WITH_TEST_VM_PUBLIC_IP:8083

# --- STORAGE (test box uses the in-stack MinIO; no GCS needed) ---------------
# Leave the STORAGE_* defaults (compose points at the bundled minio). For a
# GCS test instead, set STORAGE_ENDPOINT_URL=https://storage.googleapis.com +
# GCS HMAC keys and remove the minio service.
MINIO_ROOT_USER=testadmin
MINIO_ROOT_PASSWORD=REPLACE_with_openssl_rand_hex_16

# --- DB / misc (test defaults fine) -----------------------------------------
POSTGRES_PASSWORD=test_pg_secret
HOMER_IP=127.0.0.1
# ENV stays development on the test box so the prod dev-secret guard doesn't fire.
ENV=development

# --- SHARED DID INVENTORY (Phases 2-3) --------------------------------------
# INVENTORY_READ_URL: read-only prod replica for DID inventory/ownership reads.
# Leave EMPTY until the East replica exists — empty falls back to the local
# primary (DATABASE_URL), i.e. today's behavior (no-op). Once the standby below
# is running, point this at it (Phase 4):
#   INVENTORY_READ_URL=postgresql://inventory_ro:INVROPASS@postgres-replica:5432/voip
INVENTORY_READ_URL=
# DEPLOY_ENV: which environment this box serves. This is the SANDBOX.
DEPLOY_ENV=sandbox
# INVENTORY_GUARD_ENFORCE: routing reconciliation guard. true = reject creating/
# updating RCF routing for a DID the shared inventory allocates to another env.
# Untracked DIDs (not in inventory) are always allowed. Set false to disable.
INVENTORY_GUARD_ENFORCE=true

# --- PHASE 1: read-replica standby (opt-in "replica" compose profile) --------
# The postgres-replica service streams from the PROD primary. See
# infra/replica/README.md. REPL_PASSWORD must match the 'replicator' role you
# create on prod; REPLICA_PRIMARY_HOST is the prod VPC IP.
REPLICA_PRIMARY_HOST=10.142.0.103
REPL_PASSWORD=
# REPL_USER / REPL_SLOT default to replicator / sandbox_replica (override if needed).
