# =============================================================================
# RCF-V1 Production — Media Server VM Environment
# =============================================================================
# Copy to .env on VM2 and fill in all REQUIRED values.
#
# Usage: docker compose -f docker-compose.media.yml up -d

# VM2 public IP — SIP and RTP bind addresses
EXTERNAL_SIP_IP=          # VM2 public IP (REQUIRED)
EXTERNAL_RTP_IP=          # VM2 public IP (REQUIRED)

# PostgreSQL via PgBouncer on VM3
DB_HOST=                  # VM3 internal IP (REQUIRED)
DB_PORT=6432
DB_NAME=voip
DB_USER=freeswitch
DB_PASS=                  # Strong password (REQUIRED)

# Redis — runs locally in Docker, exposed on host port 6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# FastAPI on VM3
API_HOST=                 # VM3 internal IP
API_PORT=8000

# Homer SIP capture on VM3
HOMER_IP=                 # VM3 internal IP

# Primary SBC internal IP — for Record-Route and dispatcher
SBC_PROXY_IP=             # Primary SBC internal IP (REQUIRED)

# FreeSWITCH Event Socket — change from default ClueCon
ESL_PASSWORD=             # Strong password, NOT ClueCon (REQUIRED). Must match
                          # FREESWITCH_ESL_PASSWORD on the Services VM.

# Set true to enable test routes and synthetic CDRs
TEST_MODE=false

# Per-attempt carrier PDD bound (seconds) for the SBC/carrier failover loop.
BRIDGE_PROGRESS_TIMEOUT=10

# =============================================================================
# UCaaS / unified image (Phase 1-8)
# =============================================================================
# SEC-2 ingest auth: FS sends this as X-Ingest-Secret on the multipart
# recording/voicemail uploads to the Services VM API. MUST be IDENTICAL to the
# INGEST_SHARED_SECRET set on the Services VM. Generate: openssl rand -hex 32
INGEST_SHARED_SECRET=     # REQUIRED — must match Services VM value

# <Say> TTS engine. Default tts_commandline (Piper). Set TTS_ENGINE=flite to
# use the built-in flite fallback. OPTIONAL.
TTS_ENGINE=tts_commandline
TTS_DEFAULT_VOICE=slt

# api_voice.lua webhook HTTP knobs — OPTIONAL (safe defaults shown).
WEBHOOK_HTTP_TIMEOUT=5
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_BACKOFF_MS=200
# Dev-only: permit non-HTTPS webhook URLs. Keep false in production.
WEBHOOK_ALLOW_HTTP=false

# mod_verto WSS TLS — combined cert+privkey PEM and cert/CA chain (paths INSIDE
# the container). Mount a CA-issued cert into /usr/local/freeswitch/conf/tls and
# point these at it. OPTIONAL (committed dev self-signed certs are the default).
VERTO_TLS_PEM=/usr/local/freeswitch/conf/tls/wss.pem
VERTO_TLS_CHAIN=/usr/local/freeswitch/conf/tls/wss.crt

# =============================================================================
# coturn — TURN/STUN (co-located on this Media VM; Verto/WebRTC runs on FS here)
# =============================================================================
# static-auth-secret for RFC 5766 time-limited creds. MUST be IDENTICAL to the
# TURN_SECRET on the Services VM API (webrtc.py mints creds with the same secret).
TURN_SECRET=              # REQUIRED — must match Services VM value
TURN_REALM=voip.local     # MUST match the Services VM TURN_REALM
# Host dir holding the CA-issued turns: cert (mounted read-only at
# /etc/coturn/certs). OPTIONAL — leave default for plain STUN/TURN (no TLS).
# e.g. /etc/letsencrypt/live/turn.example.com
TURN_CERT_DIR=./docker/coturn/certs
