# =============================================================================
# RCF-V1 Production — Media Server VM Environment
# =============================================================================
# Copy to .env on VM2 and fill in all REQUIRED values.
#
# Usage: docker compose -f docker-compose.media.yml up -d

# VM2 public IP — SIP and RTP bind addresses
EXTERNAL_SIP_IP=          # VM2 public IP (REQUIRED)
EXTERNAL_RTP_IP=          # VM2 public IP (REQUIRED)

# PostgreSQL via PgBouncer on VM3
DB_HOST=                  # VM3 internal IP (REQUIRED)
DB_PORT=6432
DB_NAME=voip
DB_USER=freeswitch
DB_PASS=                  # Strong password (REQUIRED)

# Redis — runs locally in Docker, exposed on host port 6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# FastAPI on VM3
API_HOST=                 # VM3 internal IP
API_PORT=8000

# Homer SIP capture on VM3
HOMER_IP=                 # VM3 internal IP

# Primary SBC internal IP — for Record-Route and dispatcher
SBC_PROXY_IP=             # Primary SBC internal IP (REQUIRED)

# FreeSWITCH Event Socket — change from default ClueCon
ESL_PASSWORD=             # Strong password, NOT ClueCon (REQUIRED)

# Set true to enable test routes and synthetic CDRs
TEST_MODE=false

# =============================================================================
# revup-ops-agent — READ-ONLY NOC command API (fs role) for this media VM.
# Serves the ted-next console's FreeSWITCH reads (sofia status, show
# channels/calls, uuid_dump, status — over the LOCAL ESL) + host docker/git/
# journalctl. Runs host-networked so it can reach FS's ESL on 127.0.0.1:8021.
# The ESL_PASSWORD above is reused by the agent to authenticate to FS's ESL.
# =============================================================================
# Shared bearer token the console presents on `Authorization: Bearer <token>` to
# POST /run. FAIL-CLOSED: if UNSET, every /run returns 401 (/healthz still
# answers). Use the SAME token the console is configured with. openssl rand -hex 32
OPS_AGENT_TOKEN=          # REQUIRED to enable the command API (else all /run 401)

# TCP port the command API listens on (binds on the VM — host networking).
# Default 8710. SECURITY: VPC-internal ONLY — add a firewall rule allowing
# tcp:8710 from just the console host(s). Not for internet exposure.
OPS_AGENT_PORT=8710

# Role this agent exposes. Forced to `fs` on the media VM (no ctl socket here).
OPS_AGENT_ROLE=fs

# ESL endpoint the agent connects to (local FreeSWITCH). Defaults are correct for
# the host-networked media VM; override only in unusual topologies.
#OPS_AGENT_ESL_HOST=127.0.0.1
#OPS_AGENT_ESL_PORT=8021

# =============================================================================
# Production metrics plane — per-zone vmagent + node_exporter (media role).
# Backs docker-compose.media.yml (vmagent + node-exporter) +
# docs/OBSERVABILITY_METRICS_PLAN.md. The vmagent scrapes local FreeSWITCH
# (mod_prometheus :9102, ESL exporter :9103) + node_exporter :9100 and
# remote-writes CROSS-ZONE to the East VictoriaMetrics.
# =============================================================================
# This zone's name — stamped as the `zone` external_label on every series.
# One of: east | west | central. (Set per media VM: East=east, West=west, …)
METRICS_ZONE=east
# East VictoriaMetrics remote_write target (the services VM internal IP). Same
# host across all zones; the default is the East services VM. Cross-zone
# remote_write is allowed by the `allow-vmagent-remote-write` firewall rule.
METRICS_REMOTE_WRITE_HOST=10.142.0.103
# Stable identity for THIS FreeSWITCH VM — stamped as `reporting_instance`. Keep
# it unique/human-readable (e.g. East legacy name fs-media-v2, West west-fs, …).
FS_NODE_ID=fs-media-v2
