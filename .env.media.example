# =============================================================================
# RCF-V1 Production — Media Server VM Environment
# =============================================================================
# Copy to .env on VM2 and fill in all REQUIRED values.
#
# Usage: docker compose -f docker-compose.media.yml up -d

# VM2 public IP — SIP and RTP bind addresses
EXTERNAL_SIP_IP=          # VM2 public IP (REQUIRED)
EXTERNAL_RTP_IP=          # VM2 public IP (REQUIRED)

# PostgreSQL via PgBouncer on VM3
DB_HOST=                  # VM3 internal IP (REQUIRED)
DB_PORT=6432
DB_NAME=voip
DB_USER=freeswitch
DB_PASS=                  # Strong password (REQUIRED)

# Redis — runs locally in Docker, exposed on host port 6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# FastAPI on VM3
API_HOST=                 # VM3 internal IP
API_PORT=8000

# Homer SIP capture on VM3
HOMER_IP=                 # VM3 internal IP

# Primary SBC internal IP — for Record-Route and dispatcher
SBC_PROXY_IP=             # Primary SBC internal IP (REQUIRED)

# FreeSWITCH Event Socket — change from default ClueCon
ESL_PASSWORD=             # Strong password, NOT ClueCon (REQUIRED). Must match
                          # FREESWITCH_ESL_PASSWORD on the Services VM.

# Set true to enable test routes and synthetic CDRs
TEST_MODE=false

# Per-attempt carrier PDD bound (seconds) for the SBC/carrier failover loop.
BRIDGE_PROGRESS_TIMEOUT=10

# =============================================================================
# E911 / Kari's Law / RAY BAUM's Act (scripts/emergency.lua). Read via os.getenv().
#
# *** PRODUCTION-REQUIRED (LIFE SAFETY) ***: entrypoint.sh HARD-FAILS FreeSWITCH
# startup on a real deployment (EXTERNAL_SIP_IP is a real public IP) when
# EMERGENCY_DEFAULT_CALLBACK is unset/invalid OR EMERGENCY_DEFAULT_LOCATION is
# empty. This is deliberate: Bandwidth E911 REJECTS a 911 whose From is not a real
# account DID, and RAY BAUM's Act requires a dispatchable location on every 911.
# Local dev (no real public EXTERNAL_SIP_IP) only WARNS, so the stack still boots.
# =============================================================================
# LAST-RESORT PSAP callback when a line has no per-line / DB-assigned callback.
# REQUIRED in production: a REAL, Granite E911-registered 10/11-digit NANP DID on
# our Bandwidth account (carrier From-auth + PSAP callback). Set it per zone.
EMERGENCY_DEFAULT_CALLBACK=          # REQUIRED e.g. 6174544217 (a real account DID)
# Fallback dispatchable location (RAY BAUM's Act) — a Bandwidth by-reference key or
# civic address. REQUIRED (non-empty) in production until per-line location wiring
# lands. A per-line `emergency_location` channel var overrides this when provisioned.
EMERGENCY_DEFAULT_LOCATION=          # REQUIRED e.g. a Bandwidth location key / civic address
# Kari's Law central-notification webhook (fire-and-forget). Empty = OFF; the
# CUSTOM emergency::dial ESL event still fires so an ESL consumer can notify.
EMERGENCY_NOTIFY_URL=
EMERGENCY_NOTIFY_SECRET=             # sent as X-Emergency-Secret when set
EMERGENCY_NOTIFY_TIMEOUT=5           # curl --max-time for the notify POST
# Overall 911 ring budget (seconds). 180 matches emergency.lua's own default.
# Life-safety: do NOT shorten — a still-ringing PSAP call must not be cancelled.
EMERGENCY_CALL_TIMEOUT=180

# Per-DID default concurrent-call cap (toll-fraud control in handlers/rcf.lua)
# when rcf_numbers.max_channels is 0/unset. 30 matches the script default.
RCF_DID_MAX_CONCURRENT_DEFAULT=30

# Microsoft Teams Direct Routing (default-OFF). Gates the public.xml
# `teams_outbound` Teams->PSTN carrier relay via the freeswitch.xml `teams_enabled`
# global: unless this is EXACTLY "true", the relay extension is INERT (H-1 defense-
# in-depth — it can never bridge an inbound INVITE out to a carrier). Set to true
# ONLY on a Teams-enabled deployment, and match the SBC's WITH_TEAMS build.
TEAMS_DIRECT_ROUTING_ENABLED=false

# =============================================================================
# UCaaS / unified image (Phase 1-8)
# =============================================================================
# SEC-2 ingest auth: FS sends this as X-Ingest-Secret on the multipart
# recording/voicemail uploads to the Services VM API. MUST be IDENTICAL to the
# INGEST_SHARED_SECRET set on the Services VM. Generate: openssl rand -hex 32
INGEST_SHARED_SECRET=     # REQUIRED — must match Services VM value

# <Say> TTS engine. Default tts_commandline (Piper). Set TTS_ENGINE=flite to
# use the built-in flite fallback. OPTIONAL.
TTS_ENGINE=tts_commandline
TTS_DEFAULT_VOICE=slt

# api_voice.lua webhook HTTP knobs — OPTIONAL (safe defaults shown).
WEBHOOK_HTTP_TIMEOUT=5
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_BACKOFF_MS=200
# Dev-only: permit non-HTTPS webhook URLs. Keep false in production.
WEBHOOK_ALLOW_HTTP=false

# mod_verto WSS TLS — combined cert+privkey PEM and cert/CA chain (paths INSIDE
# the container). Mount a CA-issued cert into /usr/local/freeswitch/conf/tls and
# point these at it. OPTIONAL (committed dev self-signed certs are the default).
VERTO_TLS_PEM=/usr/local/freeswitch/conf/tls/wss.pem
VERTO_TLS_CHAIN=/usr/local/freeswitch/conf/tls/wss.crt

# =============================================================================
# coturn — TURN/STUN (co-located on this Media VM; Verto/WebRTC runs on FS here)
# =============================================================================
# static-auth-secret for RFC 5766 time-limited creds. MUST be IDENTICAL to the
# TURN_SECRET on the Services VM API (webrtc.py mints creds with the same secret).
# FAIL-CLOSED: compose + the coturn entrypoint both refuse to start when this
# is empty or still the committed dev sentinel (audit P0-6).
TURN_SECRET=              # REQUIRED — openssl rand -hex 32; match Services VM
TURN_REALM=voip.local     # MUST match the Services VM TURN_REALM
# GCE 1:1 NAT: relay candidates must advertise the VM PUBLIC IP. Defaults to
# EXTERNAL_SIP_IP (this VM's public IP) — only override for exotic setups.
#TURN_EXTERNAL_IP=
# Refuse relaying to RFC1918/loopback/link-local peers (VPC pivot protection).
# Keep true in production.
TURN_DENY_PRIVATE=true
# Host dir holding the CA-issued turns: cert (mounted read-only at
# /etc/coturn/certs). OPTIONAL — leave default for plain STUN/TURN (no TLS).
# e.g. /etc/letsencrypt/live/turn.example.com
TURN_CERT_DIR=./docker/coturn/certs
