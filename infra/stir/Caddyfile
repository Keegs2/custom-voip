# ============================================================================
# STIR/SHAKEN x5u — public HTTPS static endpoint (Caddy)
# ============================================================================
# Serves ONLY public STIR/SHAKEN certificate material, at exactly three paths:
#
#     https://{$X5U_DOMAIN}/stir/8052-2026.pem            (our x5u chain)
#     https://{$X5U_DOMAIN}/stir/sti-pa-trust-bundle.pem  (STI-PA trusted-CA list)
#     https://{$X5U_DOMAIN}/stir/sti-pa-crl.pem           (STI-PA CRL, daily)
#
# The first is the `x5u` value embedded in every signed PASSporT — other
# carriers' STIR/SHAKEN verifiers fetch it over HTTPS to validate our Identity
# header. The second and third are the STI-PA trust list + revocation list OUR
# OWN SBCs cron-pull to chain/screen inbound callers' certs
# (refresh-sbc-trust-bundle.sh); each 404s until refresh-stir-trust-bundle.sh
# installs it on this VM.
#
# The on-disk source is infra/stir/granite-shaken-8052-x5u.pem (PUBLIC, no
# private key), bind-mounted READ-ONLY at /srv/stir inside the container. We
# map the URL path /stir/8052-2026.pem onto that single file with `rewrite`
# so there is no second copy to drift out of sync.
#
# Automatic HTTPS: Caddy obtains + renews a public Let's Encrypt certificate
# for {$X5U_DOMAIN} via the ACME HTTP-01 challenge on :80, then serves HTTPS
# on :443 and redirects :80 -> :443. The ACME account + issued cert live in
# Caddy's data dir, which is a NAMED VOLUME so they persist across restarts
# (re-issuing repeatedly hits Let's Encrypt rate limits).
#
# SECURITY POSTURE:
#   - Read-only static file server. NO reverse_proxy to anything.
#   - Exactly one public content path; everything else -> 404.
#   - No directory listing (file_server without `browse`).
#   - This container shares NOTHING with docker-compose.services.yml.
# ============================================================================

# Global options — set the ACME contact email (env-driven, placeholder default).
{
	email {$X5U_ACME_EMAIL:admin@example.com}
}

# ----------------------------------------------------------------------------
# Container healthcheck site — plain HTTP, LOOPBACK HOSTS ONLY.
# The compose healthcheck wgets http://127.0.0.1/healthz. Without this block,
# Caddy's auto-HTTPS redirected that to https://127.0.0.1, where the TLS
# handshake can only fail (SNI mismatch — the cert is for the public domain
# only), so the container sat "unhealthy" while serving the public site fine.
# Host-scoped to loopback, so the public domain's ACME HTTP-01 challenges
# (Caddy injects challenge handlers ahead of site routes on :80) and its
# :80 -> :443 redirect are unaffected. Deep health of the PUBLIC endpoint is
# monitored separately by the blackbox probes on the STIR/SHAKEN board.
# ----------------------------------------------------------------------------
http://127.0.0.1, http://localhost {
	@healthz path /healthz
	handle @healthz {
		header Content-Type "text/plain; charset=utf-8"
		respond "ok" 200
	}
	handle {
		respond "Not Found" 404
	}
}

# ----------------------------------------------------------------------------
# The public x5u site. Caddy auto-provisions a Let's Encrypt cert for this
# hostname (HTTP-01 on :80) and serves it on :443.
# ----------------------------------------------------------------------------
{$X5U_DOMAIN:fs-cert.granitevoip.com} {

	# Root for static content. The cert PEM is bind-mounted READ-ONLY here.
	root * /srv/stir

	# ---- Uptime probe (optional): GET /healthz -> 200 "ok" ----
	# Handled before the cert matcher so monitors don't 404. No sensitive info.
	@healthz path /healthz
	handle @healthz {
		header Content-Type "text/plain; charset=utf-8"
		respond "ok" 200
	}

	# ---- The x5u certificate, served at EXACTLY /stir/8052-2026.pem ----
	# Match only that one URL path; rewrite it onto the real on-disk filename
	# so the returned bytes are granite-shaken-8052-x5u.pem verbatim.
	@x5u path /stir/8052-2026.pem
	handle @x5u {
		# STIR/SHAKEN cert-chain media type (RFC 8555 / IANA) + 1-day cache.
		header Content-Type "application/pem-certificate-chain"
		header Cache-Control "public, max-age=86400"
		rewrite * /granite-shaken-8052-x5u.pem
		file_server
	}

	# ---- STI-PA trusted-CA bundle, served at EXACTLY /stir/sti-pa-trust-bundle.pem ----
	# The multi-CA trust list our SBCs chain INBOUND callers' x5u certs to
	# (CertCAFile). PUBLIC CA material — safe to serve. Installed/refreshed on
	# this VM by infra/stir/refresh-stir-trust-bundle.sh into /var/lib/stir,
	# which is a SEPARATE read-only DIRECTORY mount (/srv/stir-trust) so the
	# script's atomic rename is visible here with no restart. 404s until the
	# first install. Shorter cache (1h) than the x5u cert so STI-PA list
	# changes propagate to the SBC cron pulls within the hour.
	@trust path /stir/sti-pa-trust-bundle.pem
	handle @trust {
		root * /srv/stir-trust
		header Content-Type "application/pem-certificate-chain"
		header Cache-Control "public, max-age=3600"
		rewrite * /sti-pa-trust-bundle.pem
		file_server
	}

	# ---- STI-PA CRL, served at EXACTLY /stir/sti-pa-crl.pem ----
	# The STI-PA revocation list (PEM CRL, reissued DAILY with a 24h
	# nextUpdate). Installed/refreshed on this VM by refresh-stir-trust-
	# bundle.sh (pinned-signature + strict freshness gates) into the same
	# /var/lib/stir dir; SBCs pull it in the same daily cron as the trust
	# bundle for libsecsipid CertCRLFile (CertVerify bit 16). 404s until the
	# CRL lifecycle is activated — harmless: the SBC pull treats that as "not
	# published". Short cache (15 min): the content turns over daily and
	# staleness here is meaningful (revocation data).
	@crl path /stir/sti-pa-crl.pem
	handle @crl {
		root * /srv/stir-trust
		header Content-Type "application/pkix-crl"
		header Cache-Control "public, max-age=900"
		rewrite * /sti-pa-crl.pem
		file_server
	}

	# ---- Everything else -> 404. No listing, no other paths, no proxy. ----
	handle {
		respond "Not Found" 404
	}
}
