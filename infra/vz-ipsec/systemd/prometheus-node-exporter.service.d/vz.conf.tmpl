# Rendered by install.sh -> /etc/systemd/system/prometheus-node-exporter.service.d/vz.conf
# Debian's unit runs `/usr/bin/prometheus-node-exporter $ARGS` (ARGS from /etc/default/prometheus-node-exporter).
# This drop-in replaces ExecStart to add (plan §3.5):
#   --collector.xfrm                  native kernel xfrm counters — ONLY when the installed node_exporter supports it
#                                     (>= 1.6; Debian 12 ships 1.5.0, so on stock Debian 12 this is empty and the
#                                     counters come from vz-healthd: vz_ipsec_xfrm_out_no_states_total /
#                                     vz_ipsec_xfrm_in_state_seq_error_total). install.sh feature-detects the flag.
#   --collector.textfile.directory    where vz-healthd writes vz_ipsec.prom
#   --web.listen-address              NIC IP only — this VM owns a PUBLIC IKE IP on ens4; never expose :9100 on it
# $ARGS is kept so distro defaults still apply.

[Service]
ExecStart=
ExecStart=/usr/bin/prometheus-node-exporter ${VZ_NE_XFRM_FLAG} --collector.textfile.directory=/var/lib/node_exporter/textfile_collector --web.listen-address=${VZ_NIC_IP}:9100 $ARGS
