# /opt/revup/.env for ONE Verizon IPsec gateway VM  (infra/vz-ipsec — plan docs/VERIZON_IPSEC_TRUNKS_PLAN.md)
# Copy the row for THIS gateway from infra/vz-ipsec/README.md "Per-gateway values", paste here, run install.sh.
# No secrets in this file: the PSK lives in /etc/swanctl/conf.d/secrets.conf (mode 600), created by the operator.
# All variables are REQUIRED unless marked optional. install.sh refuses placeholders except VZ_PEER_IP / VZ_PREFIXES.

# ---- identity ----
VZ_ZONE=central                     # east|west|central — metric label + hostname sanity check ({zone}-vz-gw-{gw})
VZ_GW=a                             # a|b — gw-a is the ILB primary group, gw-b the failover group (§2.3)

# ---- this VM (§3.1, §4.1) ----
VZ_NIC_IP=192.168.31.4              # ens4 VPC address on the zone's vz-ipsec-{zone} /28 (192.168.x1.0/28)
VZ_IKE_IP=34.68.252.50              # the reserved static IP protocol-forwarded to THIS VM ({zone}-vz-ike-{gw}); IKE + ESP outer source
VZ_SUBNET_GW=192.168.31.1           # the /28's gateway (first usable address) — next hop for default + VPC routes
VZ_GW_ILB_IP=192.168.31.2           # the zone's next-hop ILB address ({zone}-vz-gw-ilb); added as a LOCAL route on lo so VIP-addressed HC probes terminate here (§3.5)

# ---- zone addressing the NAT translates between (§2.1, §2.2) ----
VZ_ZONE_SIP=35.184.132.124          # {zone}-vz-sip — in-tunnel SIP source Verizon sees; reserved, NEVER attached to a VM
VZ_SBC_VIP=10.128.0.251             # SBC Verizon VIP ({zone}-sbc-verizon-fwd) — what the zone SIP IP translates to
VZ_SBC1_IP=10.128.0.100             # SBC-1 VPC IP — may source in-dialog traffic; translated to the zone SIP IP on the way out
VZ_SBC2_IP=10.128.0.101             # SBC-2 VPC IP — same
VZ_FS1_NIC=192.168.30.2             # FS-1 NIC (media)      } Verizon sends RTP to the FS PUBLIC IP (already in SDP);
VZ_FS1_PUB=35.253.103.114           # FS-1 existing public  } the gateway translates PUB <-> NIC both ways
VZ_FS2_NIC=192.168.30.3             # FS-2 NIC
VZ_FS2_PUB=34.63.100.161            # FS-2 existing public

# ---- Verizon side (§10 inputs — PLACEHOLDERS until the SE answers; install.sh then skips the tunnel config) ----
VZ_PEER_IP=PLACEHOLDER              # Verizon's IKE peer address for THIS tunnel (a and b differ)
VZ_PREFIXES=PLACEHOLDER             # comma list of Verizon SIP + media prefixes, e.g. "203.0.113.0/24, 198.51.100.0/25" — routed into the tunnel + allowed in forward
#VZ_PEER_ID=                        # optional — Verizon's IKE-ID; default = VZ_PEER_IP ("General IKE-ID", confirm with Verizon)
#VZ_LOCAL_ID=                       # optional — our IKE-ID; default = VZ_IKE_IP

# ---- optional knobs (defaults are the plan's) ----
#VZ_IF_ID=42                        # xfrm interface id (if_id_in/out + the xfrm-vz netdev); default 42
#VZ_DRAIN_FILE=/run/vz-drain        # drain file for deliberate failover (vz-drain.sh); keep under /run so a reboot clears it
