# EXAMPLE ONLY — this file is never rendered or installed by install.sh.
#
# The real file is /etc/swanctl/conf.d/secrets.conf, mode 0600 root:root, created BY THE OPERATOR
# on each gateway (README "Where the PSK lives"). It is never in git, OpenTofu, or /opt/revup/.env (plan §3.2 "PSK").
#
# id-1 / id-2 select this PSK for the vz connection by IKE identity (plan §3.2 "General IKE-ID"):
#   id-1 = this gateway's IKE IP  (VZ_LOCAL_ID, default VZ_IKE_IP)
#   id-2 = Verizon's peer IP       (VZ_PEER_ID,  default VZ_PEER_IP)
# One tunnel = one PSK. gw-a and gw-b of a zone have DIFFERENT peers and (normally) different PSKs.
#
# After writing/changing it:  swanctl --load-creds   (then swanctl --initiate --child vz if the SA was down)

secrets {
    ike-vz {
        id-1 = 192.0.2.1
        id-2 = 198.51.100.1
        secret = "REPLACE-WITH-THE-PSK-VERIZON-ASSIGNED-TO-THIS-TUNNEL"
    }
}
