# =============================================================================
# RCF-V1 Production — SBC VM Environment
# =============================================================================
# Copy to .env on each SBC VM and fill in all REQUIRED values.
# Each SBC VM (KAM-G1, KAM-G2) gets its own .env with its own public IP.
#
# Usage: docker compose -f docker-compose.sbc.yml up -d

# This SBC's public IP — binds SIP listeners here
EXTERNAL_SIP_IP=          # This SBC's public IP (REQUIRED)

# FreeSWITCH media server — VM2 internal IP
FREESWITCH_IP=            # VM2 internal IP (REQUIRED)

# PostgreSQL via PgBouncer on VM3 — trunk IP auth, sqlops queries
DB_HOST=                  # VM3 internal IP
DB_PORT=6432              # PgBouncer port on VM3
DB_USER=freeswitch
DB_PASS=                  # Strong password (REQUIRED)

# Homer SIP capture — heplify-server on VM3
HOMER_IP=                 # VM3 internal IP

# This SBC's own VPC IP — FS-facing listen socket + inner Record-Route.
SBC_INTERNAL_IP=          # e.g. East SBC-1: 10.142.0.100 / SBC-2: 10.142.0.101

# FreeSWITCH VM's OWN public IP — used in SDP body rewrites (RTP target).
# Distinct from EXTERNAL_SIP_IP (the NLB VIP). Falls back to EXTERNAL_SIP_IP.
FS_PUBLIC_IP=             # e.g. East media VM: 34.139.119.135

# Homer/log correlation IDs.
HEP_CAPTURE_ID=100        # East=100, West=110, Central=120
SBC_ID=east-sbc-1         # e.g. east-sbc-1, east-sbc-2, west-sbc-1

# =============================================================================
# Per-zone Bandwidth egress PoPs (OPTIONAL — East values are the defaults).
# BANDWIDTH_IP_1 = primary (X-Carrier=primary), BANDWIDTH_IP_2 = secondary.
# Each zone routes outbound to its NEAREST PoP first, the other as failover.
#   East:  PRIMARY=67.231.2.12 (Dallas), SECONDARY=216.82.238.134 (LA)
#   West:  PRIMARY=216.82.238.134 (LA),  SECONDARY=67.231.2.12 (Dallas)
# Leave unset on East to keep current behavior; set both on West.
# =============================================================================
# East (defaults — may omit):
#BANDWIDTH_PRIMARY_IP=67.231.2.12
#BANDWIDTH_SECONDARY_IP=216.82.238.134
# West:
#BANDWIDTH_PRIMARY_IP=216.82.238.134
#BANDWIDTH_SECONDARY_IP=67.231.2.12

# =============================================================================
# Per-zone trusted internal subnets (OPTIONAL — East values are the defaults).
# Each SBC trusts ONLY its OWN zone's VPC subnet + FS media subnet.
#   INTERNAL_SUBNET = this zone's VPC subnet (services VM + SBCs live here)
#   MEDIA_SUBNET    = this zone's FreeSWITCH media subnet
# Leave unset on East to keep current behavior; set both on West.
# =============================================================================
# East (defaults — may omit):
#INTERNAL_SUBNET=10.142.0.0/20
#MEDIA_SUBNET=192.168.10.0/24
# West:
#INTERNAL_SUBNET=10.138.0.0/20
#MEDIA_SUBNET=192.168.20.0/24

# =============================================================================
# E911 — Bandwidth TC3 / GRANITE_911 dedicated emergency trunk PoPs (OPTIONAL).
# Defaults are the long-standing GRANITE_911 production IPs, so leaving these
# unset is byte-identical to current production. FreeSWITCH scripts/emergency.lua
# egresses 911 with X-Carrier=emergency; Kamailio routes it here and fails over
# Dallas<->Atlanta. Also drives dispatcher.list group 6 (life-safety keepalive).
# =============================================================================
#BANDWIDTH_E911_1=67.231.1.137   # Dallas (primary E911)
#BANDWIDTH_E911_2=67.231.12.71   # Atlanta (secondary E911)

# =============================================================================
# STIR/SHAKEN (RFC 8224 / RFC 8588) — DEFAULT-OFF. We are the VSP (originate +
# terminate). The secsipid module + STIR_SIGN/STIR_VERIFY routes compile in ONLY
# when STIRSHAKEN_PRIVKEY_PATH is set; empty = OFF = byte-identical config.
#
# EXTERNAL PROVISIONING (process, not code — see report):
#   1. Obtain your SPC token from the STI-PA (iconectiv) using your OCN.
#   2. Get an ES256 SHAKEN signing certificate from an approved STI-CA.
#   3. Publish the cert at a public HTTPS URL -> STIRSHAKEN_CERT_URL (PASSporT x5u).
#   4. Mount the matching private key into the SBC container and point
#      STIRSHAKEN_PRIVKEY_PATH at it (see the commented volume in
#      docker-compose.sbc.yml — container path must equal this value).
#   5. Register in the FCC Robocall Mitigation Database.
# =============================================================================
#STIRSHAKEN_PRIVKEY_PATH=/etc/kamailio/stirshaken/signing.key  # set = feature ON
#STIRSHAKEN_CERT_URL=https://certs.granitevoip.example/shaken.pem
#STIRSHAKEN_ATTEST_DEFAULT=A          # A|B|C — A: we own the calling TN
#STIRSHAKEN_VERIFY=yes                # inbound annotate-only (route checks =="yes")
#STIRSHAKEN_CACHE_DIR=/var/lib/kamailio/secsipid-cache  # persisted via named volume
