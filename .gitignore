# Environment and secrets
.env
*.key
*.pem
*.crt

# OS files
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Docker volumes (should never be committed)
postgres_data/
redis_data/
freeswitch_logs/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Terraform state
*.tfstate
*.tfstate.backup
.terraform/

# Terraform variable files — may hold secrets (PagerDuty key, etc.). Keep .example tracked.
*.tfvars
!*.tfvars.example

# Keys and credentials
.keys/
*.json.key

# Grafana NOC / GCP monitoring secrets. Ignore everything under secrets/ EXCEPT
# the tracked placeholder + README, so a real downloaded SA key dropped here
# (any name) is never committed. On prod the operator edits the placeholder
# ON THE VM (deploy is git-pull only), so the real key never flows back to git.
secrets/*
!secrets/gcp-monitoring-sa.json
!secrets/README.md
