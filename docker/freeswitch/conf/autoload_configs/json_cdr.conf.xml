<?xml version="1.0" encoding="utf-8"?>
<!--
  mod_json_cdr Configuration
  Posts JSON CDR data to the FastAPI server after every completed call.

  Multi-VM: api_host and api_port are set in freeswitch.xml from env vars
  API_HOST and API_PORT. Docker default: api:8000. Multi-VM: set API_HOST
  to the API server IP (e.g., 10.142.0.103) and API_PORT (e.g., 8088).

  NOTE: The API must expose a POST /v1/cdrs/ingest endpoint that accepts the
  mod_json_cdr JSON payload. That endpoint is responsible for extracting the
  channel variables and mapping them into the cdrs table schema.
-->
<configuration name="json_cdr.conf" description="JSON CDR">
  <settings>

    <!-- ============================================ -->
    <!-- HTTP POST Target                            -->
    <!-- ============================================ -->

    <!-- Primary CDR receiver — FastAPI server.
         In Docker: api:8000. In multi-VM: set API_HOST/API_PORT env vars. -->
    <param name="url" value="http://$${api_host}:$${api_port}/v1/cdrs/ingest"/>

    <!-- HTTP timeout in seconds. Keep short so a slow/dead API server
         does not block FreeSWITCH channel teardown. 5s is generous for
         a local loopback POST. -->
    <param name="timeout" value="5"/>

    <!-- Disable SSL certificate verification (internal network). -->
    <param name="ssl-cert-check" value="false"/>

    <!-- ============================================ -->
    <!-- Logging and Fallback                        -->
    <!-- ============================================ -->

    <!-- log-http-and-disk=true: write EVERY CDR to log-dir on disk IN
         ADDITION to the HTTP POST (not only on failure). With log-b-leg=true
         this also writes one file per B-leg attempt — watch log-dir growth
         on the freeswitch_logs volume. (A CDR whose POST fails after all
         retries is written to err-log-dir.) -->
    <param name="log-http-and-disk" value="true"/>

    <!-- Directory for the on-disk JSON CDR copies (see log-http-and-disk).
         This path is inside the container (freeswitch_logs volume). -->
    <param name="log-dir" value="/var/log/freeswitch/json_cdr"/>

    <!-- Directory where a CDR is written when its HTTP POST still fails
         after all retries (replay source). Not a console-logging switch. -->
    <param name="err-log-dir" value="/var/log/freeswitch/json_cdr/errors"/>

    <!-- ============================================ -->
    <!-- Leg Selection                               -->
    <!-- ============================================ -->

    <!-- The ONLY live leg filter in mod_json_cdr is `log-b-leg` (HTTP
         Request Settings block below). There is NO `cdr-leg` parameter —
         the old `cdr-leg=a` line here was inert and has been removed.

         prefix-a-leg: naming of the ON-DISK CDR files only (A-leg files get
         an "a_" prefix so they are distinguishable from B-leg files now that
         B-legs are logged). It does NOT select which legs are posted. -->
    <param name="prefix-a-leg" value="true"/>

    <!-- ============================================ -->
    <!-- JSON Encoding                               -->
    <!-- ============================================ -->

    <!-- URL-encode values in the JSON output to prevent injection
         of special characters (e.g., quotes in caller ID names)
         that could break JSON parsing on the API side. -->
    <param name="encode-values" value="false"/>

    <!-- Pretty-print JSON for disk-logged CDRs (easier to debug).
         The HTTP-posted version is compact regardless. -->
    <param name="indent" value="1"/>

    <!-- ============================================ -->
    <!-- Channel Variables to Include                -->
    <!-- ============================================ -->

    <!-- By default mod_json_cdr includes ALL channel variables in the
         "variables" object of the JSON payload. This is the safest
         approach because our Lua scripts set many custom variables
         (customer_id, product_type, trunk_id, etc.) and we do not
         want to miss any.

         If you need to restrict to specific variables only (to reduce
         payload size), uncomment the lines below and set
         "channel-vars" to the explicit list. For now, we include
         everything and let the API server pick what it needs.

         MUST STAY COMMENTED while the A/B split is on: the B-leg rows are
         built from the cdr_* vars (cdr_leg, cdr_carrier_leg, cdr_call_id,
         cdr_leg_attempt, cdr_direction, cdr_customer_id, ...) and the
         stale list below contains none of them — enabling it would make
         every B-leg POST drop at the ingest.
    -->

    <!--
    <param name="channel-vars" value="customer_id,product_type,trunk_id,direction,traffic_grade,carrier_used,fraud_score,blocked_reason,forward_to,call_reference,api_tier,per_call_fee,carrier_gateway,hangup_cause,sip_term_status,bridge_hangup_cause,billsec,duration,uuid,caller_id_number,caller_id_name,destination_number,sip_received_ip,sip_from_user,freeswitch_hostname"/>
    -->

    <!-- ============================================ -->
    <!-- HTTP Request Settings / B-leg split         -->
    <!-- ============================================ -->

    <!-- encode=true: the body is POSTed as application/x-www-form-urlencoded
         `cdr=<url-encoded JSON>` (the ingest handles this form,
         docker/api/src/routers/cdrs.py ~:1182). NOT a Content-Type knob and
         NOT base64 (that would be encode=base64). Leave as-is. -->
    <param name="encode" value="true"/>

    <!-- log-b-leg=true: CDR A/B LEG SPLIT IS ON (docs/CDR_LEG_SPLIT_CONTRACT.md,
         docs/CDR_BILLING_REMEDIATION_PLAN.md section 4). Every ORIGINATED
         (B-leg) session also posts its own CDR, not just the A-leg. This is
         THE per-zone cutover switch; false = A-leg only (pre-split behavior).

         The ingest writes a B row ONLY when the B channel carries
         cdr_leg=B AND cdr_carrier_leg=true — set per-leg ("[cdr_*]" dial-
         string block) ONLY on carrier bridge attempts by inbound_router.lua
         (RCF off-net failover loops) and trunk_outbound.lua. On-net B-legs
         (trunk PBX delivery, local ext) post but produce NO row.

         Volume: one POST per bridge ATTEMPT. RCF worst case = 8 carrier
         attempts (4 trunks x 2 SBCs) + the A-leg = 9 POSTs for one call;
         typical answered call = 2.

         Activation: this file is read ONLY at module load. The conf dir is
         bind-mounted, so after `git pull` run `reloadxml` then
         `reload mod_json_cdr` via fs_cli (see docker/freeswitch/conf/CLAUDE.md
         "mod_json_cdr"). A container restart is NOT required. -->
    <param name="log-b-leg" value="true"/>

    <!-- Retries after a failed POST (so up to 1+retries attempts per CDR). -->
    <param name="retries" value="2"/>

    <!-- Seconds to wait between retries. -->
    <param name="delay" value="2"/>

    <!-- SYNCHRONOUS-POST EXPOSURE (plan section 4.7 trap 2): mod_json_cdr posts
         from the session's own reporting state handler, so a slow/dead API
         holds each finished session (thread + memory, NOT the RTP ports,
         which are released at hangup) for up to
         timeout x (1+retries) + delay x retries = 5x3 + 2x2 = 19 s
         before the CDR falls back to err-log-dir. The split multiplies the
         number of sessions posting (up to 9 per RCF call in a full failover
         storm), so a sustained API outage at high CPS inflates the live
         session count toward switch.conf max-sessions=10000 — watch
         `show channels count`/`show calls count` if the API is degraded.
         Each B-leg reports on ITS OWN session thread, so a slow POST never
         delays the A-leg's next failover attempt. Values deliberately
         unchanged (retries/timeout tuning is a separate decision). -->

  </settings>
</configuration>
