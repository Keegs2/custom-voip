<?xml version="1.0" encoding="utf-8"?>
<!--
  Sofia SIP Module Configuration
  Main configuration file for the SIP stack

  Profile Definitions:
  - internal: Traffic from Kamailio SBC (port 5080)
  - Additional profiles can be added for direct carrier connections
-->
<configuration name="sofia.conf" description="Sofia SIP Endpoint">

  <!-- ============================================ -->
  <!-- GLOBAL SETTINGS                             -->
  <!-- ============================================ -->
  <global_settings>
    <!-- Logging level (0=off, 1-9 increasing verbosity) -->
    <param name="log-level" value="0"/>

    <!-- Auto-restart profiles on failure -->
    <param name="auto-restart" value="true"/>

    <!-- Debug presence events (0=off) -->
    <param name="debug-presence" value="0"/>

    <!-- SIP trace level for FreeSWITCH console/log output of SIP messages.
         Valid values: console, alert, crit, err, warning, notice, info, debug.
         This controls the FS log level at which SIP messages are printed.
         It does NOT affect HEP capture (that's controlled by TPTAG_CAPT).
         Set to "info" to see SIP traces in the log without full debug verbosity. -->
    <param name="tracelevel" value="info"/>

    <!-- HEP capture server for Homer SIP monitoring.
         This is a GLOBAL setting — per-profile capture-server params are silently
         ignored by mod_sofia (only global_settings capture-server is recognized).
         The capture_id here applies to ALL profiles.

         NOTE: To distinguish FS from Kamailio in Homer, use a different capture_id
         than Kamailio (which uses 100/110/120 per zone). FreeSWITCH uses 200/210/220
         per zone (East/West/Central), set via the hep_capture_id global var
         (freeswitch.xml, from HEP_CAPTURE_ID env). It MUST be unique per zone so the
         ladder can tell which zone's FS captured a message — a hardcoded 200 would
         make every zone's FreeSWITCH collide.

         NOTE: sip-capture is NOT recognized in global_settings — it must be set
         per-profile in each sofia profile's <settings> block.
    -->
    <param name="capture-server" value="udp:$${homer_ip}:9060;hep=3;capture_id=$${hep_capture_id}"/>

    <!-- RFC compliance for multipart MIME -->
    <param name="rfc2833-pt" value="101"/>

    <!-- Maximum UDP packet size -->
    <param name="max-udp-body-length" value="65536"/>

    <!-- Port range for ephemeral SIP ports -->
    <!-- <param name="sip-port-range-start" value="5100"/> -->
    <!-- <param name="sip-port-range-end" value="5199"/> -->

  </global_settings>

  <!-- ============================================ -->
  <!-- SIP PROFILES                                -->
  <!-- ============================================ -->
  <profiles>
    <!-- Internal profile - receives traffic from Kamailio SBC (port 5080) -->
    <X-PRE-PROCESS cmd="include" data="../sofia/internal.xml"/>

    <!-- External profile - carrier-facing outbound calls (port 5090) -->
    <!-- Uses ext-sip-ip/ext-rtp-ip for proper public IP in Via/Contact/SDP -->
    <X-PRE-PROCESS cmd="include" data="../sofia/external.xml"/>

    <!--
      Additional profiles can be added here:

      WebRTC profile for browser clients:
      <X-PRE-PROCESS cmd="include" data="../sip_profiles/webrtc.xml"/>
    -->
  </profiles>

</configuration>
