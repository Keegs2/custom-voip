                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "CPS · peak 1h",
      "description": "Peak calls-per-second over the last hour (max per-minute rate, all zones). 🟠 ≥ 350 · 🔴 ≥ 500 soft capacity.",
      "datasource": {
        "type": "postgres",
        "uid": "voip-cdr-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "voip-cdr-pg"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(max(cps),0) AS cps FROM (SELECT count(*)::float/60.0 AS cps FROM cdrs WHERE start_time > now() - interval '1 hour' GROUP BY date_trunc('minute',start_time)) s;"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "decimals": 1,
          "noValue": "0",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 350
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "ASR · 15m",
      "description": "Answer-seizure ratio (answered ÷ seized) in the last 15 minutes, all zones. 🟢 normal PSTN ~35–70%. '—' = no recent calls.",
      "datasource": {
        "type": "postgres",
        "uid": "voip-cdr-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "voip-cdr-pg"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT (count(*) FILTER (WHERE answer_time IS NOT NULL))::float/NULLIF(count(*),0) AS asr FROM cdrs WHERE start_time > now() - interval '15 minutes';"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
