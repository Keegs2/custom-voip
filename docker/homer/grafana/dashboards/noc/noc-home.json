    {
      "id": 15,
      "type": "stat",
      "title": "Bandwidth Dallas · primary",
      "description": "Live reachability of the Bandwidth Dallas carrier trunk (67.231.2.12) from the SBCs' Kamailio-dispatcher OPTIONS probes (carrier_trunk_health, duid bw-dallas-primary). 🟢 UP (reachable from ≥1 SBC) · 🔴 DOWN (dead on every SBC) · 🟠 STALE (no fresh probe in 90s). Proactive — independent of call traffic.",
      "datasource": {
        "type": "postgres",
        "uid": "voip-cdr-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "voip-cdr-pg"
          },
          "format": "table",
