            "uid": "voip-cdr-pg"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT avg(mos) AS mos FROM cdrs WHERE start_time > now() - interval '15 minutes' AND mos IS NOT NULL;"
