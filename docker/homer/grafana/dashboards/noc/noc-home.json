      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**Live System Status** — 🟢 green = healthy · 🔴 red = attention · hover any tile or map dot for detail.  ·  **Map:** 🟢 datacenter (dot size = calls / hour) · 🔺 carrier trunk (🟢 up · 🔴 down — live OPTIONS probe)."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Fleet VMs up",
      "description": "Total production VMs reporting hypervisor CPU across all 3 datacenters. Expected 13 (5 East + 4 West + 4 Central; west-loadtest excluded). 🟢 13/13 · 🔴 any down.",
      "datasource": {
        "type": "stackdriver",
        "uid": "gcp-monitoring"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "timeSeriesList",
          "datasource": {
            "type": "stackdriver",
            "uid": "gcp-monitoring"
          },
          "timeSeriesList": {
            "projectName": "rugged-night-193017",
            "filters": [
              "metric.type",
              "=",
              "compute.googleapis.com/instance/cpu/utilization",
              "AND",
              "metadata.system_labels.name",
              "=~",
              "poc-custom-voip|kam-g2|fs-media-v2|services|east-db-standby|west-sbc-1|west-sbc-2|west-fs|west-db|central-sbc-1|central-sbc-2|central-fs|central-db"
            ],
            "crossSeriesReducer": "REDUCE_COUNT",
            "perSeriesAligner": "ALIGN_MEAN",
            "alignmentPeriod": "+300s",
            "groupBys": [],
            "view": "FULL"
          }
        }
      ],
