    {
      "id": 3,
      "type": "stat",
      "title": "Call volume · 15m",
      "description": "Calls seized platform-wide in the last 15 minutes (all zones/products). Live traffic pulse; 0 during quiet periods is normal on this pre-beta box.",
      "datasource": {
        "type": "postgres",
        "uid": "voip-cdr-pg"
      },
      "gridPos": {
        "x": 4,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "voip-cdr-pg"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS calls FROM cdrs WHERE start_time > now() - interval '15 minutes';"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "fieldConfig": {
