    {
      "id": 6,
      "type": "stat",
      "title": "MOS · 15m",
      "description": "Average call MOS of rated calls, last 15 minutes. 🟢 ≥ 4.0 · 🔴 < 3.6. '—' = no rated calls (RTP quality capture is a follow-up on the RCF path).",
      "datasource": {
        "type": "postgres",
        "uid": "voip-cdr-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 2,
        "w": 4,
