    {
      "id": 11,
      "type": "geomap",
      "title": "US datacenters · live regions, carriers & traffic",
      "description": "Geographic view of the 3 GCP datacenters (green, sized by calls in the last hour) and the Bandwidth carrier trunks. Carrier triangles are GREEN when the trunk is UP per the SBCs' live Kamailio-dispatcher OPTIONS probes (reachable from >=1 SBC) and RED when it is DOWN on every SBC or its status is stale (no fresh probe in 90s) / not yet reported. This is a proactive probe, independent of call traffic, so a dead carrier shows even at zero volume. Hover a triangle for status, SBCs up / reporting, and seconds since last probe. Datacenter up/down, VIP reachability and servers up/down are the zone tiles in the left rail; carrier up/down are the Bandwidth tiles in the left rail. Hover any marker for detail.",
      "datasource": {
        "type": "postgres",
        "uid": "voip-cdr-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 2,
        "w": 18,
        "h": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "voip-cdr-pg"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT z.name, z.lat, z.lon, COALESCE(c.calls,0) AS calls_1h FROM (VALUES ('East',33.13::float8,-80.01::float8,'east'),('West',45.60::float8,-121.18::float8,'west'),('Central',41.26::float8,-95.86::float8,'central')) AS z(name,lat,lon,zk) LEFT JOIN (SELECT split_part(coalesce(sbc_id,''),'-',1) AS zone, count(*) AS calls FROM cdrs WHERE start_time > now() - interval '1 hour' GROUP BY 1) c ON c.zone=z.zk;"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "postgres",
            "uid": "voip-cdr-pg"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(h.name, z.name) AS name, z.lat, z.lon, CASE WHEN h.status = 'up' THEN 1 ELSE 0 END AS up, COALESCE(h.status,'unknown') AS status, COALESCE(h.up_sbcs,0) AS up_sbcs, COALESCE(h.total_sbcs,0) AS total_sbcs, CASE WHEN h.last_updated IS NULL THEN NULL ELSE round(EXTRACT(EPOCH FROM (now() - h.last_updated)))::int END AS probe_age_s FROM (VALUES ('bw-dallas-primary','Bandwidth Dallas',32.78::float8,-96.80::float8),('bw-la-secondary','Bandwidth LA',34.05::float8,-118.24::float8)) AS z(duid,name,lat,lon) LEFT JOIN carrier_trunk_health h ON h.duid = z.duid ORDER BY z.duid;"
        }
