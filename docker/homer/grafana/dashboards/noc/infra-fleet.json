{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": ["noc"],
      "targetBlank": false,
      "title": "NOC dashboards",
      "tooltip": "Other Production NOC dashboards",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "## Infrastructure · Fleet Detail\nPer-VM CPU / memory / disk / network time series. Use the **Zone** dropdown to focus East / West / Central (or All). Memory & disk come from the Ops Agent; CPU & network are available from the hypervisor even without it."
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU utilization — $zone",
      "description": "compute.googleapis.com/instance/cpu/utilization per VM in the selected zone.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 2 },
      "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "rugged-night-193017",
            "filters": [
              "metric.type", "=", "compute.googleapis.com/instance/cpu/utilization",
              "AND", "metadata.system_labels.name", "=~", "${zone:raw}"
            ],
            "crossSeriesReducer": "REDUCE_NONE",
            "perSeriesAligner": "ALIGN_MEAN",
            "alignmentPeriod": "+60s",
            "groupBys": ["metadata.system_labels.name"],
            "view": "FULL"
          },
          "aliasBy": "{{metadata.system_labels.name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory % used — $zone",
      "description": "agent.googleapis.com/memory/percent_used (state=used) per VM. Ops Agent required.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 2 },
      "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "rugged-night-193017",
            "filters": [
              "metric.type", "=", "agent.googleapis.com/memory/percent_used",
              "AND", "metric.label.state", "=", "used",
              "AND", "metadata.system_labels.name", "=~", "${zone:raw}"
            ],
            "crossSeriesReducer": "REDUCE_NONE",
            "perSeriesAligner": "ALIGN_MEAN",
            "alignmentPeriod": "+60s",
            "groupBys": ["metadata.system_labels.name"],
            "view": "FULL"
          },
          "aliasBy": "{{metadata.system_labels.name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Disk % used — $zone (real FS)",
      "description": "agent.googleapis.com/disk/percent_used (state=used), tmpfs/udev/overlay/loop excluded, per VM+device. Ops Agent required.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "rugged-night-193017",
            "filters": [
              "metric.type", "=", "agent.googleapis.com/disk/percent_used",
              "AND", "metric.label.state", "=", "used",
              "AND", "metric.label.device", "!=~", "tmpfs|udev|overlay.*|/dev/loop.*",
              "AND", "metadata.system_labels.name", "=~", "${zone:raw}"
            ],
            "crossSeriesReducer": "REDUCE_NONE",
            "perSeriesAligner": "ALIGN_MEAN",
            "alignmentPeriod": "+60s",
            "groupBys": ["metadata.system_labels.name", "metric.label.device"],
            "view": "FULL"
          },
          "aliasBy": "{{metadata.system_labels.name}} {{metric.label.device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network traffic — $zone",
      "description": "agent.googleapis.com/interface/traffic (RX+TX, per direction) per VM. Ops Agent required.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "rugged-night-193017",
            "filters": [
              "metric.type", "=", "agent.googleapis.com/interface/traffic",
              "AND", "metadata.system_labels.name", "=~", "${zone:raw}"
            ],
            "crossSeriesReducer": "REDUCE_SUM",
            "perSeriesAligner": "ALIGN_RATE",
            "alignmentPeriod": "+60s",
            "groupBys": ["metadata.system_labels.name", "metric.label.direction"],
            "view": "FULL"
          },
          "aliasBy": "{{metadata.system_labels.name}} {{metric.label.direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Uptime check — pass fraction (front doors)",
      "description": "monitoring.googleapis.com/uptime_check/check_passed, fraction of probes passing per host across checker regions. 1.0 = all regions green.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "rugged-night-193017",
            "filters": [
              "metric.type", "=", "monitoring.googleapis.com/uptime_check/check_passed"
            ],
            "crossSeriesReducer": "REDUCE_MEAN",
            "perSeriesAligner": "ALIGN_FRACTION_TRUE",
            "alignmentPeriod": "+60s",
            "groupBys": ["resource.label.host"],
            "view": "FULL"
          },
          "aliasBy": "{{resource.label.host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["min", "mean"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Uptime check — request latency (ms)",
      "description": "monitoring.googleapis.com/uptime_check/request_latency per host (mean across checker regions). Rising latency is an early warning before a probe fails.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "rugged-night-193017",
            "filters": [
              "metric.type", "=", "monitoring.googleapis.com/uptime_check/request_latency"
            ],
            "crossSeriesReducer": "REDUCE_MEAN",
            "perSeriesAligner": "ALIGN_MEAN",
            "alignmentPeriod": "+60s",
            "groupBys": ["resource.label.host"],
            "view": "FULL"
          },
          "aliasBy": "{{resource.label.host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ],
