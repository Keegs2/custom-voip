    {
      "id": 201,
      "type": "timeseries",
      "title": "CPU utilization — $zone",
      "description": "compute.googleapis.com/instance/cpu/utilization per VM in the selected zone.",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 7 },
      "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "rugged-night-193017",
            "filters": [
              "metric.type", "=", "compute.googleapis.com/instance/cpu/utilization",
              "AND", "metadata.system_labels.name", "=~", "${zone:raw}"
            ],
            "crossSeriesReducer": "REDUCE_MEAN",
            "perSeriesAligner": "ALIGN_MEAN",
            "alignmentPeriod": "+60s",
            "groupBys": ["metadata.system_labels.name"],
            "view": "FULL"
          },
          "aliasBy": "{{metadata.system_labels.name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
