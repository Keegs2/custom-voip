    {
      "id": 100,
      "type": "text",
      "title": "",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "## Production NOC · Infrastructure\nFleet wall-board — 14 production VMs across East / West / Central, the 3 SIP VIPs, and the API/UI front doors. Green = healthy. A VM tile goes **red when the hypervisor CPU metric is absent** (same signal as the `VM down (metrics absent)` alert). CPU/mem/disk in the table come from the Ops Agent."
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "VMs Up",
      "description": "Count of production VMs currently emitting the hypervisor CPU metric, out of 14. A VM stops reporting within ~1-2 min of stopping/crashing.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 2 },
      "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "rugged-night-193017",
            "filters": [
              "metric.type", "=", "compute.googleapis.com/instance/cpu/utilization",
              "AND", "metadata.system_labels.name", "=~",
              "poc-custom-voip|kam-g2|fs-media-v2|services|east-db-standby|west-sbc-1|west-sbc-2|west-fs|west-db|central-sbc-1|central-sbc-2|central-fs|central-db"
            ],
            "crossSeriesReducer": "REDUCE_COUNT",
            "perSeriesAligner": "ALIGN_MEAN",
            "alignmentPeriod": "+300s",
            "groupBys": [],
            "view": "FULL"
          }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 14,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 13 },
              { "color": "green", "value": 14 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SIP VIPs Up",
      "description": "SIP NLB VIPs (East/West/Central) passing their uptime checks, out of 3. Fraction of probes passing per VIP averaged across checker regions; >0.5 counts as up.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 2 },
      "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "rugged-night-193017",
            "filters": [
              "metric.type", "=", "monitoring.googleapis.com/uptime_check/check_passed",
              "AND", "resource.label.host", "=~",
              "34.24.133.82|35.252.214.40|35.253.133.230"
            ],
            "crossSeriesReducer": "REDUCE_COUNT_TRUE",
            "perSeriesAligner": "ALIGN_FRACTION_TRUE",
            "alignmentPeriod": "+300s",
            "groupBys": ["resource.label.host"],
            "view": "FULL"
          }
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": ["lastNotNull"],
            "includeTimeField": false,
            "mode": "seriesToRows"
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "all",
            "filters": [
              { "fieldName": "Last", "config": { "id": "greater", "options": { "value": 0 } } }
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["count"], "fields": "/^Last$/", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 3,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 2 },
              { "color": "green", "value": 3 }
            ]
          }
        },
        "overrides": []
      }
    },
