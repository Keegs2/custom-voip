      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**Fleet at a glance** — per-zone VM up/down status (🟢 all VMs reporting · 🔴 any missing / 'DOWN') across the top, with fleet resource time series below: CPU, memory, disk, network, and front-door uptime pass-fraction + latency. Use the **Zone** dropdown to focus East / West / Central (or All). Memory, disk & network come from the Ops Agent; CPU & network are available from the hypervisor even without it."
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "East · us-east1",
      "description": "East datacenter health = East VMs reporting hypervisor CPU (0..6). Expected 6: poc-custom-voip, kam-g2, fs-media-v2, east-fs-2 (media-HA hot standby), services, east-db-standby. 🟢 6/6 · 🔴 any missing / whole DC 'DOWN'. ~5-min smoothed.",
      "datasource": {
        "type": "stackdriver",
        "uid": "gcp-monitoring"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "gcp-monitoring"
          },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "rugged-night-193017",
            "filters": [
              "metric.type",
              "=",
              "compute.googleapis.com/instance/cpu/utilization",
              "AND",
              "metadata.system_labels.name",
              "=~",
              "poc-custom-voip|kam-g2|fs-media-v2|east-fs-2|services|east-db-standby"
            ],
            "crossSeriesReducer": "REDUCE_COUNT",
            "perSeriesAligner": "ALIGN_MEAN",
            "alignmentPeriod": "+300s",
            "groupBys": [],
            "view": "FULL"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "DOWN",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "0 / 6",
                  "index": 0
                },
                "1": {
                  "text": "1 / 6",
                  "index": 1
                },
                "2": {
                  "text": "2 / 6",
                  "index": 2
                },
                "3": {
                  "text": "3 / 6",
                  "index": 3
                },
                "4": {
                  "text": "4 / 6",
                  "index": 4
                },
                "5": {
                  "text": "5 / 6",
                  "index": 5
                },
                "6": {
                  "text": "6 / 6",
                  "index": 6
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 10
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 6
              }
            ]
          }
        },
        "overrides": []
      }
    },
