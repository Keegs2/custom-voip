      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Per-datacenter health at a glance.** Top row = each DC (🟢 all VMs reporting · 🔴 a VM is missing metrics / whole DC down). Strip below = reachability: the 3 SIP VIPs the carrier dials + the API/UI front door. All green = system healthy. Expand a zone for per-VM detail, or **Fleet resources** for CPU / memory / disk. Hover any panel's ⓘ for query notes."
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "East · us-east1",
      "description": "East datacenter health. Value = East VMs reporting hypervisor CPU (0..5). Expected 5: poc-custom-voip, kam-g2 (SBCs), fs-media-v2 (FreeSWITCH), services (DB primary + API + UI), east-db-standby. 🟢 5/5 · 🔴 any missing, or 'DOWN' if the whole DC is dark (same signal as the 'VM down / metrics absent' alert). ~5-min smoothed. Carrier reachability is the East SIP VIP tile below.",
      "datasource": {
        "type": "stackdriver",
        "uid": "gcp-monitoring"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "gcp-monitoring"
          },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "rugged-night-193017",
            "filters": [
              "metric.type",
              "=",
              "compute.googleapis.com/instance/cpu/utilization",
              "AND",
              "metadata.system_labels.name",
              "=~",
              "poc-custom-voip|kam-g2|fs-media-v2|services|east-db-standby"
            ],
            "crossSeriesReducer": "REDUCE_COUNT",
            "perSeriesAligner": "ALIGN_MEAN",
            "alignmentPeriod": "+300s",
            "groupBys": [],
            "view": "FULL"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "DOWN",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "0 / 5",
                  "index": 0
                },
                "1": {
                  "text": "1 / 5",
                  "index": 1
                },
                "2": {
                  "text": "2 / 5",
                  "index": 2
                },
                "3": {
                  "text": "3 / 5",
                  "index": 3
                },
                "4": {
                  "text": "4 / 5",
                  "index": 4
                },
                "5": {
                  "text": "5 / 5",
                  "index": 5
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 10
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      }
    },
