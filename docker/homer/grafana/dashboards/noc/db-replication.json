        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Size" },
            "properties": [ { "id": "unit", "value": "bytes" } ]
          }
        ]
      }
    },
    {
      "id": 21,
      "type": "table",
      "title": "Replication slots",
      "description": "pg_replication_slots on the primary. active=false on a physical slot means a standby is gone but the slot still pins WAL — a known services-VM disk-fill risk (see slot-WAL watchdog).",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 25 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT slot_name, slot_type, active, COALESCE(pg_wal_lsn_diff(pg_current_wal_lsn(), restart_lsn), 0) AS retained_wal_bytes FROM pg_replication_slots ORDER BY retained_wal_bytes DESC;"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "renameByName": {
          "slot_name": "Slot", "slot_type": "Type", "active": "Active", "retained_wal_bytes": "Retained WAL"
        } } }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [ { "displayName": "Retained WAL", "desc": true } ],
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": true },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Retained WAL" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 536870912 },
                { "color": "red", "value": 2147483648 }
              ] } }
            ]
          },
          { "matcher": { "id": "byName", "options": "Active" },
            "properties": [ { "id": "mappings", "value": [
              { "type": "value", "options": { "true": { "color": "green", "index": 0, "text": "true" }, "false": { "color": "red", "index": 1, "text": "false" } } }
            ] }, { "id": "custom.cellOptions", "value": { "type": "color-text" } } ]
          }
        ]
      }
    },
    {
