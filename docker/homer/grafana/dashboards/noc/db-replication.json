  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "## Database & Replication\nEast `services` VM (10.142.0.103) is the **PG primary** holding ALL zones' CDRs. It streams via **4 physical slots** — `east_standby` (HA), `west_standby`, `central_standby`, `sandbox_replica` — to the zone read-replicas that serve DID lookups. **A DISCONNECTED or LAGGING replica serves stale routing in its zone.** All SQL is real-time against the primary via `voip-cdr-pg`; DB-VM host metrics come from `gcp-monitoring`."
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Primary status",
      "description": "pg_is_in_recovery() on the primary. 1 = PRIMARY accepting writes (this query succeeding also proves the primary is up). 0 = the box is in recovery (a standby got promoted / split-brain) — writes are refused.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 2 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN pg_is_in_recovery() THEN 0 ELSE 1 END AS primary_ok;"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": {
              "1": { "text": "PRIMARY · writes OK", "color": "green", "index": 0 },
              "0": { "text": "IN RECOVERY", "color": "red", "index": 1 }
            } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Replicas in sync",
      "description": "Of the physical slots (expected: east_standby, west_standby, central_standby, sandbox_replica = 4), how many are active AND streaming AND < 10s replay lag, shown as in_sync / total. Green only when ALL are in sync; anything less is red (a standby is disconnected or lagging).",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 2 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE s.active AND r.state = 'streaming' AND COALESCE(EXTRACT(EPOCH FROM r.replay_lag), 0) < 10) AS in_sync, count(*) AS total FROM pg_replication_slots s LEFT JOIN pg_stat_replication r ON r.pid = s.active_pid WHERE s.slot_type = 'physical';"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^in_sync$/", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": {
              "4": { "text": "4 / 4 in sync", "color": "green", "index": 0 },
              "3": { "text": "3 / 4 · 1 down", "color": "red", "index": 1 },
              "2": { "text": "2 / 4 · 2 down", "color": "red", "index": 2 },
              "1": { "text": "1 / 4 · 3 down", "color": "red", "index": 3 },
              "0": { "text": "0 / 4 · all down", "color": "red", "index": 4 }
            } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 4 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Max replay lag (bytes)",
      "description": "Largest replay-LSN byte gap across all streaming standbys right now (pg_wal_lsn_diff(pg_current_wal_lsn(), replay_lsn)). Same-region should be tiny; cross-region a bit higher. A large, GROWING value = a stuck replica.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 2 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(max(pg_wal_lsn_diff(pg_current_wal_lsn(), replay_lsn)), 0) AS max_replay_lag_bytes FROM pg_stat_replication;"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 33554432 },
              { "color": "red", "value": 134217728 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Max replay lag (time)",
      "description": "Largest replay_lag interval across standbys, in seconds. This is wall-clock delay behind the primary. Carrier-critical: a zone reading a lagging replica serves stale routing.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 2 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(max(EXTRACT(EPOCH FROM replay_lag)), 0) AS max_replay_lag_seconds FROM pg_stat_replication;"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 30 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "All databases — status",
      "description": "One row per database: the PRIMARY plus every expected physical replication slot (LEFT JOINed to pg_stat_replication, so a standby that is GONE still shows as a DISCONNECTED row rather than vanishing). STATUS is color-coded: WRITES OK / IN SYNC green, LAGGING orange, IN RECOVERY / DISCONNECTED red. This is the one-glance answer to 'are all DBs up and the replicas in sync?'.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT 'PRIMARY (East)' AS database, 'primary' AS role, CASE WHEN pg_is_in_recovery() THEN 'IN RECOVERY' ELSE 'WRITES OK' END AS status, 0::numeric AS lag_bytes, 0::numeric AS lag_seconds, '-' AS state UNION ALL SELECT s.slot_name AS database, 'replica' AS role, CASE WHEN NOT s.active OR r.pid IS NULL THEN 'DISCONNECTED' WHEN r.state = 'streaming' AND COALESCE(EXTRACT(EPOCH FROM r.replay_lag), 0) < 10 THEN 'IN SYNC' ELSE 'LAGGING' END AS status, COALESCE(pg_wal_lsn_diff(pg_current_wal_lsn(), r.replay_lsn), 0)::numeric AS lag_bytes, COALESCE(EXTRACT(EPOCH FROM r.replay_lag), 0)::numeric AS lag_seconds, COALESCE(r.state, '-') AS state FROM pg_replication_slots s LEFT JOIN pg_stat_replication r ON r.pid = s.active_pid WHERE s.slot_type = 'physical' ORDER BY role, database;"
        }
      ],
      "transformations": [
        { "id": "organize", "options": {
          "renameByName": {
            "database": "Database",
            "role": "Role",
            "status": "Status",
            "lag_bytes": "Replay lag",
            "lag_seconds": "Replay lag (s)",
            "state": "State"
          }
        } }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [ { "displayName": "Role", "desc": false } ],
        "cellHeight": "md",
        "footer": { "show": false, "reducer": ["sum"], "fields": "" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": true },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "mappings", "value": [
                { "type": "value", "options": {
                  "WRITES OK": { "color": "green", "index": 0 },
                  "IN SYNC": { "color": "green", "index": 1 },
                  "LAGGING": { "color": "orange", "index": 2 },
                  "DISCONNECTED": { "color": "red", "index": 3 },
                  "IN RECOVERY": { "color": "red", "index": 4 }
                } }
              ] },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "custom.width", "value": 180 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Replay lag" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 33554432 },
                { "color": "red", "value": 134217728 }
              ] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Replay lag (s)" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 3 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 5 },
                { "color": "red", "value": 30 }
              ] } },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Database" },
            "properties": [ { "id": "custom.width", "value": 200 } ]
          },
          {
            "matcher": { "id": "byName", "options": "Role" },
            "properties": [ { "id": "custom.width", "value": 120 } ]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Replay lag over time (bytes) — per replica",
      "description": "Trend of each standby's replay-LSN byte gap. A flat-near-zero line is healthy; a rising ramp = that replica is falling behind (network, disk, or a long recovery conflict).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT now() AS time, COALESCE(NULLIF(application_name, ''), host(client_addr)) AS metric, pg_wal_lsn_diff(pg_current_wal_lsn(), replay_lsn) AS replay_lag_bytes FROM pg_stat_replication ORDER BY 1;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 33554432 },
              { "color": "red", "value": 134217728 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Connections by state — over time",
      "description": "pg_stat_activity client backends grouped by state (active / idle / idle in transaction). Growing 'idle in transaction' can pin WAL and block VACUUM.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT now() AS time, COALESCE(state, 'unknown') AS metric, count(*) AS connections FROM pg_stat_activity WHERE backend_type = 'client backend' GROUP BY state ORDER BY 1;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "stacking": { "group": "A", "mode": "normal" },
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 20,
      "type": "table",
      "title": "Database sizes",
      "description": "On-disk size of each database on the primary (pg_database_size). 'voip' grows with CDR volume; watch it against the services-VM disk.",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 21 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT datname AS database, pg_database_size(datname) AS size_bytes FROM pg_database WHERE datistemplate = false ORDER BY size_bytes DESC;"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "renameByName": { "database": "Database", "size_bytes": "Size" } } }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [ { "displayName": "Size", "desc": true } ],
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": true },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Size" },
            "properties": [ { "id": "unit", "value": "bytes" } ]
          }
        ]
      }
    },
    {
      "id": 21,
      "type": "table",
      "title": "Replication slots",
      "description": "pg_replication_slots on the primary. active=false on a physical slot means a standby is gone but the slot still pins WAL — a known services-VM disk-fill risk (see slot-WAL watchdog).",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 21 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT slot_name, slot_type, active, COALESCE(pg_wal_lsn_diff(pg_current_wal_lsn(), restart_lsn), 0) AS retained_wal_bytes FROM pg_replication_slots ORDER BY retained_wal_bytes DESC;"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "renameByName": {
          "slot_name": "Slot", "slot_type": "Type", "active": "Active", "retained_wal_bytes": "Retained WAL"
        } } }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [ { "displayName": "Retained WAL", "desc": true } ],
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": true },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Retained WAL" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 536870912 },
                { "color": "red", "value": 2147483648 }
              ] } }
            ]
          },
          { "matcher": { "id": "byName", "options": "Active" },
            "properties": [ { "id": "mappings", "value": [
              { "type": "value", "options": { "true": { "color": "green", "index": 0, "text": "true" }, "false": { "color": "red", "index": 1, "text": "false" } } }
            ] }, { "id": "custom.cellOptions", "value": { "type": "color-text" } } ]
          }
        ]
      }
    },
