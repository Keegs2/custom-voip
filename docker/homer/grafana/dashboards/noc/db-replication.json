    {
      "id": 33,
      "type": "timeseries",
      "title": "DB VM disk % used (real FS)",
      "description": "agent.googleapis.com/disk/percent_used (state=used), tmpfs/udev/overlay/loop excluded, for the DB VMs. The primary's disk fills from WAL/CDR/backups — this is the panel to watch. Ops Agent required.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 33 },
      "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "stackdriver", "uid": "gcp-monitoring" },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "rugged-night-193017",
            "filters": [
              "metric.type", "=", "agent.googleapis.com/disk/percent_used",
              "AND", "metric.label.state", "=", "used",
              "AND", "metric.label.device", "!=~", "tmpfs|udev|overlay.*|/dev/loop.*",
