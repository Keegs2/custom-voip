    {
      "id": 10,
      "type": "timeseries",
      "title": "Signed calls per hour — by attestation level",
      "description": "Count of calls per hour by ACTUAL STIR/SHAKEN attestation LEVEL — A full / B partial / C gateway / unsigned — from the Postgres `call_attestations` table (NOT the raw metric). Unlike the metric-backed panels above, `div` is folded into the level it carries: a forwarded A-attested call (`signed_attestation='div'`) is counted as its preserved `inbound_attest` (A/B/C), so the stack reports the pure carried level. `div` only appears when the forward had no recorded inbound level (visibly flagged, not miscounted). NOTE: this panel is platform-wide — `call_attestations` lives only on the East primary and records EVERY zone's calls (all CDRs are written there via the API), so the **Zone picker does NOT apply here** (the metric-backed panels above still honour it). A growing 'unsigned' band or a collapse in A is the earliest sign of a signing-key / cert-URL fault or an upstream Identity regression.",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 11 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1h'), CASE WHEN signed_attestation = 'div' THEN COALESCE(inbound_attest, 'div') ELSE signed_attestation END AS metric, COUNT(*) AS value FROM call_attestations WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "normal", "group": "A" }
          },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "A" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "B" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] },
          { "matcher": { "id": "byName", "options": "C" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } } ] },
