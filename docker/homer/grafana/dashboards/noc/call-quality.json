    {
      "id": 30,
      "type": "stat",
      "title": "Rated-call quality snapshot — selected range/zone",
      "description": "Headline quality averages over the current range + zone across answered, rated calls. 'Rated calls' = rows with a non-NULL mos (the RTP-metric denominator). If this count is low vs total volume, most calls are unrated and the quality panels above are a small sample.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 37 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE mos IS NOT NULL) AS \"Rated calls\", avg(mos) AS \"Avg MOS\", avg(r_factor) AS \"Avg R-factor\", avg(jitter_avg_ms) AS \"Avg jitter (ms)\", avg(packet_loss_pct) AS \"Avg loss %\", avg(quality_pct) AS \"Avg quality %\" FROM cdrs WHERE $__timeFilter(start_time) AND split_part(coalesce(sbc_id,''),'-',1) LIKE '$zone';"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] }
        },
