  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "## Production NOC · Voice Products\nCarrier wall-board across East / West / Central. **ASR (Answer-Seizure Ratio)** is the headline metric — `answered / seized`. Live KPIs (last 15m) come from the CDR hypertable on the East primary (`voip-cdr-pg`); the three infra stats come from `gcp-monitoring`. Zone is derived from `split_part(sbc_id,'-',1)` — use the **Zone** filter top-right. `freeswitch_node` is often blank (known gap), so zone attribution uses `sbc_id`."
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "ASR — last 15m",
      "description": "Answer-Seizure Ratio = answered_calls / total_calls over the last 15 minutes, on the selected zone. THE headline carrier metric. answered = answer_time IS NOT NULL. Green >= 55%, amber >= 40%, red below.",
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 3 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT (count(*) FILTER (WHERE answer_time IS NOT NULL))::float / NULLIF(count(*), 0) AS asr FROM cdrs WHERE start_time > now() - interval '15 minutes' AND split_part(coalesce(sbc_id,''),'-',1) LIKE '$zone';"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.4 },
              { "color": "green", "value": 0.55 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Concurrent calls (CDR-derived)",
      "description": "Calls currently in progress right now, derived from CDR time-overlap: rows where answer_time <= now() < end_time (a call is up between answer and hangup). This is the RELIABLE concurrency source. active_calls is NOT used — it is only populated by the programmable-voice API path, not the RCF path that carries production traffic.",
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 3 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS concurrent FROM cdrs WHERE answer_time IS NOT NULL AND answer_time <= now() AND end_time > now() AND start_time > now() - interval '6 hours' AND split_part(coalesce(sbc_id,''),'-',1) LIKE '$zone';"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3000 },
              { "color": "red", "value": 6000 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CPS — last 1m",
      "description": "Calls per second = count of seized calls (by start_time) in the last 60s / 60, on the selected zone. Rated capacity is ~500 CPS per zone; amber/red are set for the all-zones view. See Traffic & Capacity for per-zone headroom.",
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 3 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*)::float / 60.0 AS cps FROM cdrs WHERE start_time > now() - interval '1 minute' AND split_part(coalesce(sbc_id,''),'-',1) LIKE '$zone';"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 350 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg MOS — last 15m",
      "description": "Mean Opinion Score averaged over answered, rated calls in the last 15m (mos IS NOT NULL). MOS is NULL on unanswered/unrated calls and those are excluded. Carrier-good >= 4.0, degraded 3.5-4.0, poor < 3.5.",
      "gridPos": { "h": 5, "w": 5, "x": 15, "y": 3 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT avg(mos) AS avg_mos FROM cdrs WHERE start_time > now() - interval '15 minutes' AND mos IS NOT NULL AND split_part(coalesce(sbc_id,''),'-',1) LIKE '$zone';"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 1,
          "max": 5,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 3.5 },
              { "color": "green", "value": 4.0 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "On-net % — last 15m",
      "description": "Share of calls short-circuited internally (carrier hairpin avoided): count(*) FILTER (WHERE on_net) / count(*). New internal-routing metric. on_net is a boolean set by FreeSWITCH; NULL/false = off-net.",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 3 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT (count(*) FILTER (WHERE on_net))::float / NULLIF(count(*), 0) AS on_net_pct FROM cdrs WHERE start_time > now() - interval '15 minutes' AND split_part(coalesce(sbc_id,''),'-',1) LIKE '$zone';"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "blue", "value": null } ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Answered vs failed — per 5m",
      "description": "Seized calls bucketed 5-minutely into answered (answer_time present) vs failed (never answered). Stacked. A rising failed band with flat answered = a routing/carrier problem.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(start_time, '5m') AS time, count(*) FILTER (WHERE answer_time IS NOT NULL) AS answered, count(*) FILTER (WHERE answer_time IS NULL) AS failed FROM cdrs WHERE $__timeFilter(start_time) AND split_part(coalesce(sbc_id,''),'-',1) LIKE '$zone' GROUP BY 1 ORDER BY 1;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "stacking": { "group": "A", "mode": "normal" },
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "answered" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "failed" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Call volume per zone — hourly",
      "description": "Total seized calls per hour per zone from cdr_hourly_stats is customer-scoped only (no sbc_id), so this trend comes from raw cdrs grouped by split_part(sbc_id,'-',1). Respects the dashboard time range but NOT the Zone filter (it shows all zones side by side).",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(start_time, '1h') AS time, CASE WHEN sbc_id IS NULL OR sbc_id = '' THEN 'unknown' ELSE split_part(sbc_id,'-',1) END AS zone, count(*) AS calls FROM cdrs WHERE $__timeFilter(start_time) GROUP BY 1, 2 ORDER BY 1;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": { "group": "A", "mode": "normal" },
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["sum", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Per-carrier ASR — 5m (Dallas / LA)",
      "description": "ASR split by carrier_used, 5-minutely. carrier_primary = Bandwidth Dallas (67.231.2.12); carrier_secondary = Bandwidth LA (216.82.238.134). 'local' (on-net) calls are excluded — they never touch a carrier. A carrier's ASR dropping vs the other flags a PoP-side issue and drives failover.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(start_time, '5m') AS time, CASE carrier_used WHEN 'carrier_primary' THEN 'Dallas (primary)' WHEN 'carrier_secondary' THEN 'LA (secondary)' ELSE carrier_used END AS carrier, (count(*) FILTER (WHERE answer_time IS NOT NULL))::float / NULLIF(count(*), 0) AS asr FROM cdrs WHERE $__timeFilter(start_time) AND carrier_used IN ('carrier_primary','carrier_secondary') AND split_part(coalesce(sbc_id,''),'-',1) LIKE '$zone' GROUP BY 1, 2 ORDER BY 1;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.4 },
              { "color": "green", "value": 0.55 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "min"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Calls (15m) · ACD · PDD proxy p95",
      "description": "Quick call-health trio for the selected zone, last 15m. Calls = seized count. ACD = avg answered duration (s). PDD proxy p95 = 95th pct of (answer_time - start_time); note this is time-to-answer from the CDR, NOT true PDD to first 18x (that needs Homer/SIP timing).",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "voip-cdr-pg" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Calls (15m)\", avg(duration_ms) FILTER (WHERE answer_time IS NOT NULL) / 1000.0 AS \"ACD (s)\", percentile_cont(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (answer_time - start_time))) FILTER (WHERE answer_time IS NOT NULL) AS \"PDD proxy p95 (s)\" FROM cdrs WHERE start_time > now() - interval '15 minutes' AND split_part(coalesce(sbc_id,''),'-',1) LIKE '$zone';"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ACD (s)" }, "properties": [ { "id": "unit", "value": "s" } ] },
          { "matcher": { "id": "byName", "options": "PDD proxy p95 (s)" }, "properties": [ { "id": "unit", "value": "s" }, { "id": "decimals", "value": 2 } ] }
        ]
      }
    },
