      "description": "Full SIP message bodies. Expand a row to see the complete SIP packet with all headers and SDP body.",
      "gridPos": { "h": 15, "w": 24, "x": 0, "y": 39 },
      "datasource": {
        "type": "loki",
        "uid": "qryn"
      },
      "targets": [
        {
          "expr": "{type=\"sip\"} |~ `${phone_number:raw}` |~ `${callid:raw}`",
          "refId": "A",
          "instant": false,
          "range": true,
          "queryType": "range",
          "maxLines": 500
