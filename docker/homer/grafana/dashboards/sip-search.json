          },
          {
            "matcher": {
              "id": "byName",
              "options": "DPort"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 60
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Proto"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 55
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Node"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 55
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Time",
            "desc": false
          }
        ],
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": ["count"],
          "countRows": true,
          "fields": ""
        }
      }
    },
    {
      "id": 3,
      "type": "qxip-flow-panel",
      "title": "SIP Ladder Diagram",
      "description": "Visual call flow between network elements. Arrows show SIP method or response code. Colors distinguish call legs (A-leg vs B-leg). Click any arrow to inspect the full SIP message.",
      "gridPos": { "h": 22, "w": 24, "x": 0, "y": 17 },
      "datasource": {
        "type": "loki",
        "uid": "qryn"
      },
      "targets": [
