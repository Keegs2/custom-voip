<clickhouse>
    <profiles>
        <default>
            <!-- Per-QUERY cap. 4GB (was 2GB) for the 32GB services VM — Homer
                 SIP-search over big time ranges is the consumer that hit the
                 2GB ceiling. Must stay below the container's 6G compose limit
                 (docker-compose.services.yml) with room for server overhead;
                 see docs/SERVICES_VM_32GB_TUNING.md. -->
            <max_memory_usage>4000000000</max_memory_usage>
            <!-- SIP number index (docker/homer/clickhouse/10_sip_number_index.sql):
                 a failing materialized view must NEVER fail qryn's insert and
                 lose SIP capture. With this on, an MV error is logged
                 (system.query_views_log status ExceptionWhileProcessing) and
                 the samples_v3 insert still succeeds — an index gap is
                 preferred to trace loss. qryn inserts as this default user. -->
            <materialized_views_ignore_errors>1</materialized_views_ignore_errors>
            <load_balancing>random</load_balancing>
        </default>
    </profiles>
    <users>
        <default>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </default>
    </users>
</clickhouse>
